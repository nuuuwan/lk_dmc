    "text": "\u0db1\u0dca\u200d\u0dc0 \u0d85\u0da9\u0dd4 \u0db4\u0dd3\u0da9\u0db1\u0dca\u200d \u0d9a\u0dbd\u0dcf\u0db4\u0dba\u0d9a \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0db1\u0dca\u0dd9\u0db8\u0db1\u0dca \u0daf\u0dd4\u0db4\u0dad\u0dca \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad \u0dca\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0dca\u0db6\u0dcf\u0d9a\u0d9a \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dba\u0dca\u0dda \u0db1\u0dd2\u0dbb\u0dca\u0db8\u0dcf\u0dab\u0dba \u0dc0\u0dd3 \u0d87\u0dad. \u0d91\u0db8 \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0\u0db8 \u0db4\u0dc0\u0dad\u0dd2\u0db8\u0dd2\u0db1\u0dca 2026 \u0d94\u0d9a\u0dca\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc3 24 \u0dc0\u0db1\u0dca\u200d \u0daf\u0dd2\u0db1\u0dca\u200d \u0dc0\u0db1\u0dca\u200d \u0dc0\u0dd2\u0da7 \u0db4\u0dd3\u0da9\u0db1\u0dca\u200d \u0d85\u0dc0\u0db4\u0dcf\u0dad\u0dba\u0d9a \u0dd9\u0d9a\u0dc0\u0dcf \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd3\u0db8\u0da7 \u0dca\u0db6\u0dcf\u0dca\u0dc4\u0ddd \u0daf\u0dd4\u0dbb\u0da7 \u0d89\u0da9 \u0d87\u0dad. \u0d89\u0db1\u0dca \u0d85\u0db1\u0dca\u200d\u0dad\u0dd4\u0dbb\u0dd4\u0dc0, \u0d91\u0dba \u0db6\u0da7\u0dc4\u0dd2\u0dbb\u0da7 \u0db6\u0dbb\u0dc0 \u0dc0\u0dba\u0db9 \u0dca\u0dd9\u0dc3\u0da7 \u0d9c\u0db8\u0db1\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd3 \u0d94\u0d9a\u0dca\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc3 25 \u0dc0\u0db1\u0dca\u200d \u0daf\u0dd2\u0db1\u0dca\u200d \u0dc0\u0db1\u0dca\u200d \u0dc0\u0dd2\u0da7 \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db4\u0dd3\u0da9\u0db1\u0dca\u200d \u0d85\u0dc0\u0db4\u0dcf\u0dad\u0dba\u0d9a \u0db6\u0dc0\u0da7\u0dad\u0dca, \u0d94\u0d9a\u0dca\u0dad\u0ddd\u0db6\u0dbb\u0dca \u0db8\u0dc3 26 \u0dc0\u0db1\u0dca\u200d \u0daf\u0dd2\u0db1\u0dca\u200d \u0d8b\u0dd9\u0dd1\u0dc3\u0db1\u0dca\u200d \u0dc0\u0db1\u0dca\u200d \u0dc0\u0dd2\u0da7 \u0dca\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0dca\u0db6\u0dcf\u0d9a\u0dca\u0d9a \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0db8\u0db0\u0dba\u0db8 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0d9a \u0db6\u0dc0\u0da7\u0dad\u0dca \u0db4\u0dad\u0dca\u0dc0\u0dd3\u0db8\u0da7 \u0d89\u0dad\u0dcf \u0d89\u0dc4\u0dc5 \u0dc3\u0db8\u0dca\u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf\u0dc0\u0d9a \u0db4\u0dc0\u0dad\u0dd3. \u0dca\u0db8\u0db8 \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dca\u0dda \u0dc3\u0dd8\u0da2\u0dd4 \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0dca\u0db1\u0dca\u200d\u0dcf\u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dd4\u0dc0\u0dd9 \u0d91\u0db8 \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba \u0dca\u0dc0\u0dad \u0d87\u0daf\u0dd3\u0dba\u0db1\u0dca\u200d \u0dc3\u0dd4\u0dc5\u0d82 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0dba \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0dca\u200d \u0dc4\u0dbb\u0dc4\u0dcf \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u200d \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0dca\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dd2\u0dad\u0daf\u0dd2\u0d9c \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dca\u0dda \u0dc0\u0dd0\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dca\u0dda \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd3\u0db8\u0d9a \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0daf\u0dd2\u0db1\u0dca\u200d \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dca\u0dda \u0daf\u0dd3 \u0d85\u0dca\u0dda\u0d9a\u0dc2\u0dcf \u0dca\u0d9a\u0dca\u0dbb\u0dca.",
