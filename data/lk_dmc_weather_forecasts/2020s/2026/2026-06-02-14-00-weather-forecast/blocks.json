  {
    "page_number": 0,
    "bbox": [
      58.32,
      553.72,
      550.72,
      643.51
    ],
    "text": "Showers or thundershowers will occur at times in Western, Sabaragamuwa and North-western provinces and in Galle, Matara, Kandy and Nuwara-Eliya districts. Heavy falls above 100 mm are likely at some places in Western and Sabaragamuwa provinces and in Galle, Matara, Kandy and Nuwara-Eliya districts.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      9.0,
      9.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      647.56,
      438.86,
      671.59
    ],
    "text": "Strong winds about (40-50) kmph can be expected at times across the island.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
