    "bbox": [
      58.56,
      456.91,
      538.34,
      538.51
    ],
    "text": "Issued at 05.30 a.m. on 16 October 2026. Cloudy sky will prevail over most parts of the Island. Showers or thundershowers will occur at times in Western, Southern, Central, Sabaragamuwa, North-Western and Northern provinces and in the Anuradhapura District.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      5.039999961853027,
      12.0,
      12.479999542236328
