  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      539.65,
      455.81,
      559.3
    ],
    "text": "Showers or thundershowers will occur at other parts of the island after 1.00 p.m.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      562.72,
      538.36,
      600.1
    ],
    "text": "Heavy falls above 100mm are likely at some places in Northern, Western and North-western provinces and in Galle, Matara, Polonnaruwa and Trincomalee districts.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      608.41,
      537.86,
      642.1
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
