    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      59.16,
      518.23,
      531.01,
      544.87
    ],
    "text": "Winds will be North-westerly or Northerly in the sea areas around the island. Wind speed will be (30-40) kmph.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      59.16,
      545.86,
      531.04,
      579.1
    ],
    "text": "Wind speed can increase up to (50-55) kmph at times in the sea areas off the coast extending from Kankasanthurai to Pottuvil via Trincomalee and Batticaloa.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      3.9600000381469727,
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      59.16,
      589.9,
      124.53,
      601.9
    ],
    "text": "State of Sea:",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      59.16,
      615.46,
      530.75,
      642.1
    ],
    "text": "The sea areas off the coast extending from Kankasanthurai to Pottuvil via Trincomalee and Batticaloa will be rough at times. The other sea areas around the island will be moderate.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
