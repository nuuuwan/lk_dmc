    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      597.91,
      533.83,
      634.63
    ],
    "text": "Strong winds about (40-50) kmph can be expected at times over Western slopes of the Central hills, Northern, North-central and Central provinces and in Hambantota and Trincomalee districts.",
