    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      528.85,
      534.03,
      567.31
    ],
    "text": "Showers or thundershowers may occur at a few places in Monaragala, Ampara and Batticaloa districts after 2.00 p.m.",
