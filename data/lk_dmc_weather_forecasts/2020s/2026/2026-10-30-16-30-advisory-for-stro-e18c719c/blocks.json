    "page_number": 1,
    "bbox": [
      56.66,
      172.82,
      379.34,
      217.58
    ],
    "text": "Issued by the Natural Hazards Early Warning Centre Issued at 04.30 p.m. 30 October 2026, valid for the next 24 hours.",
    "fonts": [
      "Calibri",
