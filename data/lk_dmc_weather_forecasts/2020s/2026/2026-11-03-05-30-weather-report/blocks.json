    "text": "\u0db6\u0da7\u0dc4\u0dd2\u0dbb-\u0db8\u0dcf\u0db0\u0dca\u200d \u0db8\u0dcf \u0db1\u0db6 \u0d9a\u0dca\u0d9a\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dca\u200d\u0db1\u0dda \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u200d\u0dba \u201c\u0db8\u0dd4\u0dbb \u0dc3\u0dd4\u201d (Murasu) \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd\u0d82 \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab \u0da7\u0dd4\u0dc0 2026 \u0db1\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca 03 \u0dc0\u0dd0\u0db1\u0dd2 \u0daf\u0dd2\u0db1\u0dca\u200d\u0dba \u0d8b\u0daf\u0dd1\u0dc3\u0db1\u0dca\u200d\u0dba 02.30 \u0dc0\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd2\u0da7, \u0db1\u0db8\u0dcf\u0db8\u0dcf \u0db4\u0dda\u0db0\u0dca\u200d\u0dad\u0dd2\u0dba \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dca \u0dc1\u0dca\u200d 15.3\u00b0 \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba\u0dd0\u0db1\u0d9c\u0db1\u0dca\u200d\u0dba\u0dc4\u0dd2\u0dbb \u0db1\u0dda\u0dc1\u0dca\u200d \u0dc1\u0dca\u200d 80.3\u00b0 \u0d86\u0dc3\u0db1\u0dca\u0db1\u0dca\u200d\u0dba\u0db1\u0dda \u0db1\u0d9a\u0dca\u0db1\u0dca\u0dbb\u0d9c\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd4\u0dab\u0dd2. \u0db1\u0db8\u0dcf\u0db8\u0dcf \u201c\u0db8\u0dd4\u0dbb \u0dc3\u0dd4\u201d \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd\u0d82 \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab \u0da7\u0dd4\u0dc0 \u0dc0\u0dba\u0db9 \u0db1\u0daf\u0dc3\u0da7 \u0d9c\u0db8\u0dcf\u0db1\u0dca \u0d9a\u0dcf\u0dbb\u0db1\u0dd4 \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0db6\u0dbd\u0d82 \u0db1\u0db4 \u0db1\u0dbb \u0dad\u0dca\u0dad\u0dd4 \u0dc0\u0db1\u0dca\u200d\u0dba \u0d85\u0dad\u0dbb, \u0d85\u0daf \u0daf\u0dd2\u0db1\u0dca\u200d\u0dba (\u0db1\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0db8\u0dcf\u0dc3 03) \u0d85\u0dc5\u0dd4\u0dba\u0db8\u0dca \u0d9a\u0dcf \u0dbd\u0d82\u0dba \u0dc0\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd2\u0da7 \u0d86\u0db1\u0dca\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dca\u200d\u0dca \u0db1\u0dc0\u0dbb\u0dc5 \u0d