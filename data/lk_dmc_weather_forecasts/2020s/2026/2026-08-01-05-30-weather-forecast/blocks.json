    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      493.75,
      538.36,
      526.27
    ],
    "text": "Due to the active Southwest monsoon, the prevailing rainy and windy conditions over the southwestern parts of the island will continue today.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      530.2,
      538.23,
      571.15
    ],
    "text": "Showers will occur at times in Western, Sabaragamuwa and North-western provinces and in Kandy, Nuwara-Eliya, Galle and Matara districts. Heavy falls above 100 mm are likely at some places.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      575.2,
      440.18,
      599.23
    ],
    "text": "A few showers may occur in Matale, Anuradhapura and Hambantota districts.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      601.87,
      380.3,
      625.99
    ],
    "text": "Mainly dry weather will prevail over the other areas of the island.",
