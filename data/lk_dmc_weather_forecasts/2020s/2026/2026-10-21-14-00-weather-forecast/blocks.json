    ],
    "sizes": [
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      201.77,
      544.63,
      407.41,
      557.11
    ],
    "text": "Issued at 2.00 p.m. on 21 October 2026",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      565.39,
      553.49,
      624.55
    ],
    "text": "The low level atmospheric disturbance near Sri Lanka has developed into a low-pressure area. Under the influence of this system, an enhancement of rainfall is expected over the island and the deep and shallow sea areas around the island during today and tomorrow.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      643.39,
      550.04,
      672.31
    ],
    "text": "The general public, as well as the naval and fishing communities, are requested to be attentive to the future forecasts and bulletins issued by the Department of Meteorology in this regard.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      691.18,
      550.63,
      753.7
    ],
    "text": "Showers or thundershowers will occur at times in Western, Sabaragamuwa, Central, Southern and North-western provinces and in Mannar district and cloudy skies can be expected over these areas. Showers or thunder showers will occur after 1.00 p.m. elsewhere of the island.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      757.36,
      550.73,
      797.26
    ],
    "text": "Heavy falls above 100 mm are likely at some places in Western, Sabaragamuwa and North-western provinces.",
    "fonts": [
      "Calibri",
      "Calibri,Bold",
      "Iskoola Pota,Bold"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      800.92,
      550.25,
      840.7
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
