    "text": "\u0dca\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db1\u0db0\u0dca\u0dba\u0db1\u0dca\u0db1 \u0d9a\u0dcf \u0dbd\u0d82\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0daf \u0dca\u0daf\u0db4 \u0dbb\u0dca\u0dad\u0dca\u0dda\u0db1\u0dca\u0db1\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0db1 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dcf\u0dbb\u0db1\u0dd4 \u0dbd\u0d82\u0db6\u0db1\u0dca\u200d\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d85\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd0\u0d9a\u0dd2 \u0dc3\u0dc4\u0dcf \u0db1\u0dd2\u0dca\u0dda\u0daf\u0db1\u0dca\u200d\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0dc0\u0db0 \u0db1\u0dca\u200d\u0dba\u0dca\u0dba\u0db1\u0dca\u0db1 \u0db4\u0dc3\u0dd4\u0dc0\u0db1\u0dca\u200d\u0dba \u0dca\u0dbd\u0d82\u0dc3 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd4\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf \u0dc0 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0db8\u0dcf\u0dc4\u0dcf\u0da2\u0dcf\u0db1\u0dca\u200d\u0dba\u0dad \u0dc0\u0dca \u0db1\u0dca\u0db1 \u0d89\u0dbd\u0dca\u0dbd\u0d82 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0d82\u0dd0\u0dca\u0dda.",
