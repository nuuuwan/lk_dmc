      14.039999961853027
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      578.65,
      533.98,
      617.11
    ],
    "text": "Showers or thundershowers may occur at a few places in Ampara and Monaragala districts after 2.00 p.m.",
    "fonts": [
      "Calibri",
      "Iskoola Pota"
    ],
    "sizes": [
      6.0,
      12.0
