    "bbox": [
      58.56,
      490.63,
      537.9,
      535.27
    ],
    "text": "The atmospheric conditions are getting favorable for afternoon thundershowers in most parts of the island from today (01).",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      11.039999961853027,
      12.0
