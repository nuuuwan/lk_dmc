  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      538.93,
      537.66,
      574.63
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      6.0,
      11.039999961853027
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      578.29,
      538.32,
      633.43
    ],
    "text": "Showers or thundershowers will occur at most part of the island after 1.00 p.m. Fairly heavy falls above 75 mm are likely at some places in Central, Sabaragamuwa, Uva, Eastern and North central provinces and in Mannar district.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
