    "bbox": [
      58.56,
      560.44,
      533.64,
      618.07
    ],
    "text": "Fairly strong winds about (30-40) kmph can be expected at times over Western slopes of the central hills Northern, North-central, North-western and Southern provinces and in Trincomalee district.",
    "fonts": [
      "Calibri",
      "Calibri-Bold"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
