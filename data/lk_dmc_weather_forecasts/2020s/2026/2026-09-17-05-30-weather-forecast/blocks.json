    "bbox": [
      58.58,
      504.64,
      555.07,
      546.79
    ],
    "text": "Several spells of showers will occur in the North western province and in Kandy and Nuwara-Eliya Districts.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      9.0,
      12.0
