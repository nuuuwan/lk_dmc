  },
  {
    "page_number": 0,
    "bbox": [
      58.58,
      550.96,
      555.07,
      593.11
    ],
    "text": "Showers or thundershowers will occur at several places in Uva and Eastern provinces and in Mullaittivu and Polonnaruwa districts after 1.00 p.m.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      9.0,
      12.0
    ]
  },
