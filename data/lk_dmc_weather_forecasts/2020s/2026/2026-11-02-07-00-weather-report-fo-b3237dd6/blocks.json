    "text": "State of Sea: The sea areas extending from Chilaw to Pottuvil via Colombo, Galle and Hambanthota may be fairly rough at times. Other sea areas around the island will be moderate.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
