      155.3
    ],
    "text": "Weather forecast for multi-day boats For the sea areas in between 20N - 10S and 60E-100E (Issued at 07.00 a.m. on 02 November 2026, for next 24 hours)",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
