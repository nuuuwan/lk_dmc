    "text": "\u0d91\u0db8\u0db1\u0dd2\u0dc3\u0dcf \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dcf\u0d82\u0dc1 10 \u0dad\u0dca 20 \u0dad\u0dca \u0dc3\u0dc4 \u0db1\u0dd0\u0db8\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dda\u0dc1\u0dcf\u0d82\u0dc1 80 \u0dad\u0dca 95 \u0dad\u0dca \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dc0\u0dbd \u0db1\u0dd0\u0dc0\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0db8\u0daf\u0db1 \u0dad\u0dd4\u0dbb\u0dd4 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd4\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dc5\u0d9a\u0dd2\u0db1 \u0db8\u0dbd\u0dc3\u0dad\u0dca \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dc0\u0dbd \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dbd \u0db8\u0dba\u0db8\u0daf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0db1\u0dca\u0dad \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1 \u0d9a\u0dbb\u0dcf \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0d9a\u0dbb\u0db1 \u0db8\u0dbd\u0dc3\u0dad\u0dca \u0d8b\u0db4\u0db8\u0daf\u0dc3\u0dca \u0db8\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0db6\u0dca.",
