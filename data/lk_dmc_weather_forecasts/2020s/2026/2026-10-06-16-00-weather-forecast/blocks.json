    "bbox": [
      58.56,
      475.39,
      538.37,
      568.99
    ],
    "text": "Issued at 04.00 p.m. on 06 October 2026 Showers or thundershowers will occur at several places in Western, Sabaragamuwa, Central, Uva, North-western and Southern provinces and in Anuradhapura and Mannar districts after 1.00 p.m. Fairly heavy falls above 75 mm are likely at some places in Western, Sabaragamuwa, Central, North-western and Southern provinces.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      11.039999961853027,
      12.0,
      12.479999542236328,
      12.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      573.28,
      537.71,
      612.67
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      9.0,
      11.039999961853027
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      616.84,
      537.89,
      781.39
    ],
    "text": "Misty conditions can be expected at some places in Central, Sabaragamuwa and Uva provinces during the early hours of the morning.",
