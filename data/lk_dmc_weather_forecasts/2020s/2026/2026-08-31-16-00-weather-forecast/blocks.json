    "text": "\u0daf\u0dd8\u0dc1\u0dca\u200d\u0dba \u0d9c\u0dbd\u0dc3 \u0dc3\u0dd6\u0dbb\u0dca\u0dba\u0dba\u0dcf \u0daf\u0d9a\u0dd4\u0dab\u0da7 \u0db8\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0d9c\u0db8\u0dca\u0daf\u0dd3, \u0d85\u0d9c \u0ddd\u0dc3\u0dad\u0dd4 \u0db8\u0dc3 28 \u0dc0\u0db1\u0dca\u200d \u0daf\u0dd2\u0db1\u0dca\u200d \u0dc3\u0dd2\u0da7 \u0dc3\u0dd0\u0db4\u0dca\u0dad\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca 07 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf\u0dc0 \u0d86\u0dc3\u0db1\u0dca\u0db1\u0dca\u200d \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d82\u0dc1\u0dca\u200d \u0dc0\u0dbd\u0da7 \u0dc3\u0dd8\u0da2\u0dd4\u0dc0\u0db8 \u0d89\u0dc4\u0dbd\u0dd2\u0db1\u0dca \u0db4\u0dc0\u0dad\u0dd3. \u0d9c\u0dc4\u0da7 (01) \u0daf\u0dd2\u0db1\u0dca\u200d \u0daf\u0dc4\u0dc0\u0dbd\u0dca 12:10 \u0da7 \u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0dad\u0dbd\u0dcf\u0dc0, \u0dc3\u0dd2\u0d82\u0dc4\u0dcf\u0dbb \u0db8, \u0dbd\u0dca\u0d9a\u0da9\u0dc0\u0dbd, \u0db1\u0dca\u200d\u0dcf\u0da0\u0dca\u0da0\u0daf\u0dd6\u0dc0, \u0db4\u0da9\u0dd2\u0d9a\u0dcf\u0dbb\u0db8\u0da9\u0dd4\u0dc0, \u0d9c \u0ddd\u0db8\u0dbb\u0db1\u0dca\u0d9a\u0dbd\u0dca\u0dbd, \u0d9c\u0dc0\u0dbb\u0dd4 \u0dbd\u0dca \u0dba\u0db1\u0dca\u200d \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dca\u200d\u0dc0\u0dbd\u0da7 \u0dc4\u0dd2\u0dbb\u0dd4 \u0db8\u0dd4\u0daf\u0dd4\u0db1\u0dca\u0dc0 \u0db4\u0dc0\u0dad\u0dd3.",
