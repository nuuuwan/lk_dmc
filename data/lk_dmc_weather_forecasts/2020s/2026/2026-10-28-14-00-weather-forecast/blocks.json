    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 2,
    "bbox": [
      58.92,
      479.71,
      392.9,
      491.71
    ],
    "text": "Winds will be South-westerly and wind speed will be (30-40) kmph.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      12.0
    ]
  },
  {
