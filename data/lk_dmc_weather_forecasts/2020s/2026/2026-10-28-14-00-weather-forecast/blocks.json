    "bbox": [
      197.33,
      194.42,
      394.94,
      206.9
    ],
    "text": "Issued at 2.00 p.m. on 28 October 2026",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0,
