  {
    "page_number": 0,
    "bbox": [
      36.0,
      387.49,
      562.55,
      498.12
    ],
    "text": "\u0d9c\u0dd2\u0db1\u0dd2\u0db8\u0d9a\u0dcf\u0db1\u0daf\u0dd2\u0d9c \u0db8\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0db8\u0db6\u0dcf\u0d9a\u0dca\u0d9a \u0dc3\u0dc4 \u0d8a\u0da7 \u0dba\u0dcf\u0db6\u0daf \u0db1\u0dd2\u0dbb\u0dd2\u0dad\u0daf\u0dd2\u0d9c \u0db8\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0db8\u0db6\u0dcf\u0d9a\u0dca\u0d9a \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0db8\u0dda \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u201cAkvan\u201d (\u0d85\u0d9a\u0dca\u0dc0\u0dcf\u0db1\u0dca\u0dad) \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0 2026 \u0db8\u0db1\u0dcf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca \u0db8\u0dc3 17 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0db4.\u0dc0. 05.30 \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d82\u0dc1 12.3\u00b0 \u0dc3\u0dc4 \u0db1\u0dd0\u0db8\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dda\u0dc1\u0dcf\u0d82\u0dc1 85.6\u00b0 \u0d86\u0dc3\u0db1\u0dca\u0dad\u0db1\u0db8\u0dda, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3. 630 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0daf\u0dd4\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0db8\u0d9a\u0dca\u0db1\u0dca\u0dad\u0dbb\u0d9c\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd2\u0dab\u0dd2. \u0db8\u0dd9\u0dd9 \u0db4\u0daf\u0dca\u0db0\u0dad\u0dd2\u0dba \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db8\u0dd9\u0db8\u0dd2\u0db1\u0dca \u0d8b\u0dad\u0dd4\u0dbb\u0dd4-\u0dc0\u0dba\u0db9 \u0db8\u0daf\u0dca\u200d\u0dd9\u0da7 \u0d9c\u0dd9\u0db1\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca, 2026 \u0db8 \u0dcf\u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca \u0dd9\u0dd9 18 \u0dc0 \u0daf\u0dd2 \u0db8\u0db4 .\u0dc0 .05.30 \u0db4\u0dd9\u0dab \u0dc0 \u0dc0\u0dd2\u0da7 \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0dd9\u0db0\u0dba\u0dd9 \u0db8\u0db6\u0dd9\u0d82\u0d9c\u0dcf\u0dbd \u0db8\u0db6\u0dcf\u0d9a\u0dca\u0d9a \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dca\u0dc1\u0db8\u0dda\u0daf\u0dd3 \u201c\u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0d9a\u0dca\u201d \u0daf\u0dca\u200d\u0d9a\u0dca\u0dc0\u0dcf \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc0\u0dbb\u0dca\u0db0 \u0dba \u0dc0\u0dd3\u0dd9\u0da7 \u0d89\u0dad\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0d89\u0da9\u0d9a\u0da9\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd3.",
