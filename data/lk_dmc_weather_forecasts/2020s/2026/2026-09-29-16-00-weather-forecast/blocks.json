  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      590.41,
      538.36,
      645.67
    ],
    "text": "Showers or thundershowers may occur at several places in Uva, Eastern and Central provinces and in Polonnaruwa and Mullaittivu districts after 1.00 p.m. Fairly heavy falls above 50 mm are likely at some places in the above areas.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      649.36,
      538.29,
      689.14
    ],
    "text": "A Few shower may occur in the coastal areas of the Western Province and in the Galle and Matara districts during the morning.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      692.92,
      538.23,
      732.7
    ],
    "text": "Misty conditions can be expected at some places in Sabaragamuwa and Central provinces during the early hours of the morning.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      742.93,
      537.66,
      790.63
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
