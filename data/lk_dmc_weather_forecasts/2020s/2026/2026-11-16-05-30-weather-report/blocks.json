    ],
    "text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82 \u0d9a\u0dcf \u0dc0\u0da7 \u0d8a\u0dc3 \u0db1\u0dca\u200d\u0dba \u0db1\u0daf\u0dc3\u0dd2\u0db1\u0dca, \u0db1\u0db6 \u0d9c \u0dbd\u0d82 \u0db1\u0db6 \u0d9a\u0dca\u0d9a\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u0db4\u0dd3\u0da9\u0db1\u0dca\u200d\u0dba \u0d85\u0dc0\u0db4 \u0dad\u0dba \u2018\u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db4\u0dd3\u0da9\u0db1\u0dca\u200d\u0dba \u0d85\u0dc0\u0db4 \u0dad\u0dba\u0d9a\u0dca\u2019 \u0daf\u0d9a\u0dca\u0dc0 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dca\u200d\u0dba\u0dba \u0dc0\u0dd3 \u0d87\u0dad. \u0d8a\u0db1\u0dda \u0db4.\u0dc0. 11.30 \u0dc0\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd2\u0da7 \u0db1\u0db8\u0dcf\u0db8\u0dcf \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab \u0db8\u0dcf\u0dbd\u0d82\u0dba \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2.\u0db8\u0dd3. 640 \u0d9a\u0dca \u0db4\u0db8\u0dcf\u0dab \u0daf\u0dd4\u0dbb\u0dd2\u0db1\u0dca, \u0d8a\u0dc3 \u0db1\u0dca\u200d\u0dba \u0db1\u0daf\u0dc3\u0dd2\u0db1\u0dca \u0dc3\u0dca\u0dae \u0db1\u0dca\u200d\u0dba\u0d9c\u0dad \u0dc0\u0dd3 \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2. \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db1\u0db8\u0dcf\u0db8\u0dcf \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82 \u0d9a\u0dcf \u0db1\u0dc0\u0db1\u0dca \u0d89\u0dc0\u0dad\u0da7 \u0d87\u0db1\u0daf\u0db8\u0dd2\u0db1\u0dca \u0d85\u0daf \u0daf\u0dd2\u0db1\u0dca\u200d\u0dba (\u0db1\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca 16) \u0dc3\u0dc0\u0dc3\u0dca \u0d9a\u0dcf \u0dbd\u0d82\u0db1\u0dda\u0daf\u0dd3 \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0dc3\u0dc4\u0dcf \u0dba \u0db6\u0daf \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0db8\u0dcf\u0db0 \u0db8\u0dcf \u0db1\u0db6 \u0d9c \u0dbd\u0d82 \u0db1\u0db6 \u0d9a\u0dca\u0d9a\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u2018\u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab \u0da7\u0dd4\u0dc0\u0d9a\u0dca\u2019 \u0daf\u0d9a\u0dca\u0dc0 \u0dad\u0dca, \u0db1\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd0\u0db8\u0dca\u0db6\u0dbb\u0dca 17 \u0dc0\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd2\u0da7 \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0db8\u0dcf\u0db0 \u0db8\u0dcf \u0db1\u0db6 \u0d9c \u0dbd\u0d82 \u0db1\u0db6 \u0d9a\u0dca\u0d9a\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u2018\u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd\u0d82 \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab \u0da7\u0dd4\u0dc0\u0d9a\u0dca\u2019 \u0daf\u0d9a\u0dca\u0dc0 \u0dad\u0dca \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dca\u200d\u0dba\u0dba \u0dc0\u0dd3\u0db8\u0dcf\u0da7 \u0db1\u0db6 \u0db1\u0dc4\u0dcf\u0ddd \u0daf\u0dd4\u0dbb\u0da7 \u0d89\u0da9 \u0d87\u0dad. \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0db1\u0dca \u0daf\u0dd0\u0db1\u0dca\u200d\u0dba\u0da7 \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd0\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0db1\u0dda \u0d85\u0da9\u0dd4\u0dc0\u0dd3\u0db8\u0dcf\u0d9a\u0dca \u0d85\u0daf \u0daf\u0dd2\u0db1\u0dca\u200d\u0dba\u0db1\u0dda \u0dc3\u0dd2\u0da7 (16) \u0db6\u0dbd\u0d82 \u0db1\u0db4 \u0db1\u0dbb \u0dad\u0dca\u0dd4 \u0db1\u0dda. \u0db6\u0dc3\u0dca\u0db1\u0dcf\u0dc4\u0dd2\u0dbb, \u0dc3\u0db6\u0dbb\u0d9c\u0db8\u0dd4\u0dc0, \u0dc0\u0dba\u0db9 \u0dc3 \u0daf\u0d9a\u0dd4\u0dab \u0db4\u0dc5\u0dcf\u0dad\u0dca\u0dc0\u0dbd \u0dc3 \u0db8 \u0db1\u0dd4\u0dc0\u0dbb \u0dc3 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dbd\u0dd2\u0dba \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0d9a\u0dc0\u0dbd \u0dc0\u0dd0\u0dc3\u0dd2 \u0dc0\u0dcf\u0dbb \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0dc4\u0dda. \u0d8c\u0dc0 \u0db4\u0dc5\u0dcf\u0dc4\u0dad\u0dad\u0dca \u0d85\u0db8\u0dca\u0db4\u0dcf\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0d9a\u0dc4\u0dda\u0dad\u0dca \u0db4\u0dc3\u0dca\u0dc0\u0dbb\u0dd4 2.00 \u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0 \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0dc3\u0dca\u0dc0\u0dbd\u0dca\u0db4\u0dba\u0d9a \u0dc0\u0dd0\u0dc3\u0dd2 \u0dc4 \u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dba \u0dd0\u0d9a.",
