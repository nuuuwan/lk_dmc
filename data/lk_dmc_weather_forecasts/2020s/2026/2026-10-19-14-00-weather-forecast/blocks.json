    "sizes": [
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      550.42,
      550.73,
      597.79
    ],
    "text": "Due to the development of an atmospheric disturbance in the lower atmosphere in the vicinity of Sri Lanka, showery condition is expected to be enhanced across the island from tomorrow evening.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      3.9600000381469727,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      601.57,
      452.78,
      623.11
    ],
    "text": "Showers or thundershowers will occur in most parts of the island after 1.00 p.m.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      626.77,
      550.73,
      665.23
    ],
    "text": "Fairly heavy falls above 75 mm are likely at some places in Northern, North-central, Central and Uva provinces and in Trincomalee district.",
    "fonts": [
      "Calibri",
      "Calibri,Bold",
      "Iskoola Pota,Bold"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      667.9,
      550.73,
      705.94
    ],
    "text": "Showers may occur in the coastal areas of the Western and Northern provinces and Puttalam district during the morning.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      3.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      709.9,
      550.25,
      748.06
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      3.9600000381469727,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
