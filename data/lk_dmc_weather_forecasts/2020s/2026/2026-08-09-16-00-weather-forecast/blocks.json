  {
    "page_number": 0,
    "bbox": [
      58.56,
      534.73,
      538.37,
      574.63
    ],
    "text": "Showers or thundershowers may occur at a few places in Uva province and in Ampara, Batticaloa and Mullaitivu districts after 2.00 p.m.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.960000038146973,
      12.0
