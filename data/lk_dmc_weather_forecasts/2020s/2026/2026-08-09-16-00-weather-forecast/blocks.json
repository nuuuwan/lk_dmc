  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      578.29,
      373.46,
      599.83
    ],
    "text": "Several spells of showers may occur in North-western province.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      603.61,
      538.37,
      641.95
    ],
    "text": "Strong winds of about (30-40) kmph can be expected at times over North-central, North-western, Central and Southern provinces and Trincomalee District.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
