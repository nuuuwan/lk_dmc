    ],
    "sizes": [
      12.0,
      12.479999542236328
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      58.56,
      245.12,
      538.37,
      415.99
    ],
    "text": "The low-pressure area located in the Bay of Bengal, to the east of Sri Lanka, was located approximately 600 km east of Trincomalee. The system is expected to move northwestwards, away from the eastern coast of the island and likely to intensify into a 'depression' by today (November 15). Due to the influence of this system, cloudy skies will prevail over the entire island today. Showers will occur at times in the Northern, North-central, and Eastern provinces. Several spells of showers will occur in the Western and North-western provinces, and in the Galle and Matara districts.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      3.9600000381469727,
      12.0,
      14.039999961853027
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      58.56,
      419.77,
      537.84,
      459.55
    ],
    "text": "Showers or thundershowers may occur at a few places in the other areas of the island during the evening or night.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      58.56,
      469.3,
      538.19,
      503.11
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
  {
    "page_number": 1,
    "bbox": [
      58.56,
      506.77,
      538.22,
      563.5
    ],
    "text": "Misty conditions can be expected at some places in Western, Sabaragamuwa, Central and Uva provinces and in Galle, Matara and Kurunegala districts during the early hours of the morning.",
