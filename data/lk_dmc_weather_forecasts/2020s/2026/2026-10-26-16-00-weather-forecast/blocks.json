    "text": "\u0dca\u0db8\u0db8 \u0db4\u0dda\u0db0\u0dca\u200d\u0dad\u0dd2\u0dca\u0dda \u0dc3\u0dd8\u0da2\u0dd4 \u0db6\u0dbd\u0db4\u0dd1\u0db8\u0d9a \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dd9\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0dca\u0db1\u0dca\u200d\u0dcf\u0db8\u0dd0\u0dad\u0dd2\u0dc0\u0dd4\u0dc0\u0daf \u0d91\u0db8 \u0db4\u0dda\u0db0\u0dca\u200d\u0dad\u0dd2\u0dba \u0dca\u0dc0\u0dad \u0d87\u0daf\u0dd3\u0dba\u0db1\u0dca\u200d \u0dc3\u0dd4\u0dc5\u0dd9\u0d82 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dcf\u0dc4\u0dba \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0dca\u200d \u0dc4\u0dbb\u0dc4\u0dcf \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u200d \u0db6\u0dd0\u0dc0\u0dd2\u0db1\u0dca \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0dca\u0db1\u0dca \u0db1\u0dd2\u0dbb\u0dd2\u0dad\u0daf\u0dd2\u0d9c \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dca\u0dda \u0dc0\u0dd0\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0d85\u0dca\u0dda\u0d9a\u0dca\u0dcf \u0dca\u0d9a\u0dca\u0dbb\u0dca.",
