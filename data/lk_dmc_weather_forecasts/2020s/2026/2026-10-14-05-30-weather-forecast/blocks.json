    "bbox": [
      58.56,
      486.43,
      538.27,
      531.07
    ],
    "text": "Due to a low-level atmospheric disturbance persisting in the Bay of Bengal near Sri Lanka, cloudy skies and increased rainfall are expected to continue over the island.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      3.0,
      11.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      539.23,
      538.37,
      571.75
    ],
    "text": "Showers or thundershowers will occur at times in Northern, Eastern, Southern and Western provinces. Showers or thundershowers will occur in other parts of the island after 1.00 p.m.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      575.02,
      538.35,
      627.91
    ],
    "text": "Heavy falls above 100 mm are likely at some places in Western, Sabaragamuwa, Southern, Central, and North-western provinces and in Anuradhapura district. Fairly heavy falls above 75 mm are likely at some places in the other areas of the island.",
    "fonts": [
      "Calibri",
      "Calibri,Bold",
      "Iskoola Pota,Bold"
    ],
    "sizes": [
      3.9600000381469727,
