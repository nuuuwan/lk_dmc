  },
  {
    "page_number": 3,
    "bbox": [
      54.6,
      494.23,
      539.57,
      523.03
    ],
    "text": "Winds will be North-easterly or Northerly in the sea areas around the island. Wind speed will be (30-40) kmph.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      54.6,
      526.3,
      542.21,
      596.35
    ],
    "text": "Wind speed can increase up to 60 kmph at times in the sea areas off the coast extending from Kankasanthurai to Hambantota via Trincomalee and Batticaloa. Wind speed may increase up to 50 kmph at times in the other sea areas around the island. State of Sea:",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      3.9600000381469727,
      5.039999961853027,
      12.0
