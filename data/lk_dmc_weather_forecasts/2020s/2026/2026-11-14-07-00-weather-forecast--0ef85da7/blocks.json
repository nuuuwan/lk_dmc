  },
  {
    "page_number": 3,
    "bbox": [
      54.6,
      605.11,
      542.21,
      650.83
    ],
    "text": "The sea areas off the coast extending from Kankasanthurai to Hambantota via Trincomalee and Batticaloa will be rough at times. The other sea areas around the island may be fairly rough at times.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
    "page_number": 3,
    "bbox": [
      54.6,
      653.47,
      541.87,
      687.58
    ],
    "text": "Temporarily strong gusty winds (60-70 kmph) and very rough seas can be expected during thundershowers.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
