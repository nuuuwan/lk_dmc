    "text": "\u0d91\u0dc4\u0dd2 \u0db6\u0dbd\u0d82\u0db4\u0dd1\u0db8\u0dcf \u0daf\u0dc4\u0dcf\u0dda\u0dad\u0dd4\u0daf\u0dc0\u0db1\u0dca \u0daf\u0db6 \u0d9c \u0dbd\u0d82 \u0daf\u0db6 \u0d9a\u0dca\u0d9a\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0daf\u0dda \u0dc0\u0dd0\u0dc3\u0dd2 \u0dc3\u0dc4\u0dcf \u0dc3\u0dd4\u0dc5 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0dc0\u0dd0\u0da9\u0dd2\u0daf\u0dda. \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dc2 \u0dc1 5 \u0dad\u0dca 22\u0dad\u0dca \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba\u0dd0\u0daf\u0d9c\u0db1\u0dca\u200d\u0dba\u0dc4\u0dd2\u0dbb \u0daf\u0dda\u0dc1 \u0dc1 85\u0dad\u0dca 100\u0dad\u0dca \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dc0\u0dbd\u0d82, \u0db1\u0dca\u200d\u0dba\u0dd0\u0dc0\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0daf\u0db1\u0dca\u200d\u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd4\u0d9a\u0dcf \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0dc5\u0d9a\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u200d\u0dba \u0daf\u0dbd\u0d82\u0dc3 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0daf\u0daf\u0db1\u0dd4 \u0dbd\u0d82\u0dd0\u0daf\u0dda. \u0daf\u0db8\u0dca \u0dc0\u0db1\u0dca\u200d\u0dba\u0dc0\u0dd2\u0da7 \u0d91\u0db8\u0dcf \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0daf\u0dda \u0db0\u0dd2\u0dc0\u0dbb \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0d82 \u0daf\u0dba\u0daf\u0dd3 \u0dc3\u0dd2\u0da7\u0dd3 \u0db1\u0dca\u200d\u0dba\u0db8\u0dca \u0d91\u0db8\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1 \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d89\u0dc0\u0dad\u0dca\u0dc0\u0db1\u0dca\u200d\u0dba \u0daf\u0dbd\u0d82\u0dc3\u0dad\u0dca \u0d8b\u0db4\u0daf\u0daf\u0dc3\u0dda \u0daf\u0daf\u0db1\u0dd4 \u0dbd\u0d82\u0dd0\u0daf\u0dda. \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0