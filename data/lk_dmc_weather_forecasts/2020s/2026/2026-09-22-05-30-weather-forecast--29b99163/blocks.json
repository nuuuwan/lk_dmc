  {
    "page_number": 0,
    "bbox": [
      58.58,
      527.53,
      546.44,
      615.43
    ],
    "text": "The low-pressure area that was prevailing over the sea area of the Bay of Bengal, to the northeast of the island, has now developed into a depression. It is expected to further develop into a deep depression within the next 24 hours. Although this system will not have a direct impact on Sri Lanka, the prevailing rainy conditions in the southwestern part of the island are expected to continue due to the wind flow towards the system.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.58,
      619.09,
      554.97,
      674.38
    ],
    "text": "Showers or thundershowers will occur at times in the Western, Sabaragamuwa, Central and North-western provinces and in Galle and Matara Districts. Heavy falls about 100 mm are likely at some places in the above areas.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.58,
      677.29,
      463.97,
      695.38
    ],
