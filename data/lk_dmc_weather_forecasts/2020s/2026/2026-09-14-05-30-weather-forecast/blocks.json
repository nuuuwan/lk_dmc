    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.58,
      595.96,
      549.91,
      636.94
    ],
    "text": "Heavy falls above 100 mm are likely at some places in Western, Central, Sabaragamuwa, Southern, North-central and North-western provinces.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      8.039999961853027,
      11.039999961853027,
      12.0
    ]
  },
