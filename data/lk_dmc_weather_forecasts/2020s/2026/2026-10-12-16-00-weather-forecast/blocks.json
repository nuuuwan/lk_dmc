    ],
    "text": "GENERAL WEATHER FORECAST FOR NEXT 36 HOURS",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      5.039999961853027,
      6.960000038146973,
