    ]
  },
  {
    "page_number": 0,
    "bbox": [
      210.41,
      612.19,
      428.42,
      625.15
    ],
    "text": "Issued at 04.00 p.m. on 12 October 2026",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0,
      12.479999542236328,
      12.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      626.65,
      554.56,
      680.83
    ],
    "text": "A low-pressure area may form over the southeastern Bay of Bengal by 13 October. Under the influence of this system, an increase in rainfall is expected over the island and the deep and shallow sea areas around the island during the next few days from tomorrow (13).",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      683.38,
      554.96,
      715.9
    ],
    "text": "The general public, as well as the naval and fishing communities, are requested to be attentive to the future forecasts and bulletins issued by the Department of Meteorology in this regard.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      718.57,
      102.7,
      735.58
    ],
    "text": "Tonight:",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      738.1,
      383.66,
      753.82
    ],
    "text": "Showers or thundershowers will occur in most parts of the island.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      756.49,
      555.05,
      790.3
    ],
    "text": "Fairly heavy falls above 75 mm are likely at some places in Western, Sabaragamuwa, Central, Southern, Uva and North-Western provinces and in Anuradhapura and Mannar districts.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      792.97,
      383.66,
      826.78
    ],
    "text": "Tomorrow: Showers or thundershowers will occur in most parts of the island.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      829.57,
      555.05,
      880.18
    ],
    "text": "Heavy falls about (100-150) mm are likely at some places in Central, Sabaragamuwa, Uva and Southern provinces. Fairly heavy falls above 75 mm are likely at some places in the other areas of the island.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      882.87,
      554.79,
      916.68
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
