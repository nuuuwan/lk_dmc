  {
    "page_number": 0,
    "bbox": [
      58.32,
      479.32,
      534.05,
      580.03
    ],
    "text": "Showers will occur at times in Western, Sabaragamuwa and North-western provinces and in Kandy, Nuwara-Eliya, Galle and Matara districts. Fairly heavy falls about 75 mm are likely at some places. Showers or thundershowers may occur at a few places in Ampara, Monaragala, Hambanthota and Batticaloa districts after 2.00 p.m.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      9.0,
      12.0
