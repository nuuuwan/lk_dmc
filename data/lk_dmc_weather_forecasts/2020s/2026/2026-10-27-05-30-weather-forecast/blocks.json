  {
    "page_number": 2,
    "bbox": [
      59.42,
      553.74,
      551.37,
      718.92
    ],
    "text": "\u0dca\u0d9a\u0dcf \u0dc5\u0db9 \u0dc3\u0dd2\u0da7 \u0d9c \u0dbd\u0dca\u0dbd\u0d82, \u0db8\u0dcf \u0dad\u0dbb, \u0dc4\u0dcf\u0db8\u0dca\u0db6\u0db1\u0dca\u0dca\u0dad \u0da7, \u0dca\u0db4 \u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca, \u0db8\u0dcf\u0da9\u0d9a\u0dcf\u0dbd\u0d82\u0db4\u0dd4\u0dc0 \u0dc4\u0dcf\u0dbb\u0dc4\u0dcf \u0db8\u0dd4\u0dbd\u0d82\u0dad\u0dd2\u0dda \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0dc3 \u0dc4\u0db1\u0dcf\u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dd4\u0dc5\u0dc4\u0dda \u0dc4\u0dda\u0d9c\u0dba \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (60-65) \u0daf\u0d9a\u0dc0 \u0d89\u0dc4\u0dcf\u0dc5 \u0dba \u0dc4\u0dcf\u0dd0\u0d9a\u0dcf. \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0dc0\u0da7\u0dcf \u0dc0\u0db1 \u0dc4\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dd4\u0dc5\u0dc4\u0dda \u0dc4\u0dda\u0d9c\u0dba \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 50 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0d89 \u0dc5 \u0dba\u0dcf \u0dd0\u0d9a. \u0db8\u0dd4\u0dc4\u0dd4\u0dca\u0dda \u0dc3\u0dca\u0dc0\u0db7 \u0dc0\u0dba: \u0dca\u0d9a\u0dcf \u0dc5\u0db9 \u0dc3\u0dd2\u0da7 \u0d9c \u0dbd\u0dca\u0dbd\u0d82, \u0db8\u0dcf \u0dad\u0dbb, \u0dc4\u0dcf\u0db8\u0dca\u0db6\u0db1\u0dca\u0dca\u0dad \u0da7, \u0dca\u0db4 \u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca, \u0db8\u0dcf\u0da9\u0d9a\u0dcf\u0dbd\u0d82\u0db4\u0dd4\u0dc0 \u0dc4\u0dcf\u0dbb\u0dc4\u0dcf \u0db8\u0dd4\u0dbd\u0d82\u0dad\u0dd2\u0dda \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0dc3 \u0dc4\u0db1\u0dcf\u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dda\u0dc1 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0d89\u0dad \u0dbb\u0dc5\u0dd4 \u0dc4\u0dda. \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0dc0\u0da7\u0dcf \u0dc0\u0db1 \u0dc4\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dda\u0dc1 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dbb\u0dc5\u0dd4 \u0dc0\u0dd2\u0dba \u0dc4\u0dcf\u0dd0\u0d9a\u0dcf. \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0d82\u0db8\u0dcf \u0dc3\u0dd2\u0da7 \u0dca\u0d9a\u0dcf \u0dc5\u0db9, \u0d9c \u0dbd\u0dca\u0dbd\u0d82 \u0dc3\u0dc4\u0dcf \u0db8\u0dcf \u0dad\u0dbb \u0dc4\u0dcf\u0dbb\u0dc4\u0dcf \u0dca\u0db4 \u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dc0 \u0dca\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0dca\u0db6\u0db1\u0dca \u0dc0\u0db1\u0dca\u200d\u0dba \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0dbb\u0dc5 \u0d8b\u0dc3 \u0db8\u0dd3\u0da7\u0dbb\u0dca (2.0 - 2.5) \u0d9a \u0db4\u0db8\u0dcf\u0dab \u0d89\u0dc4\u0dcf\u0dc5 \u0dba \u0dca\u0db8\u0dca \u0dc4\u0dcf\u0dd0\u0d9a\u0dd2\u0dba \u0dc0\u0d9a \u0db4\u0dc0\u0dad\u0dd3. \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1\u0dca\u200d\u0dba \u0dc0\u0da7 \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0dc4\u0dcf \u0dca\u0db1\u0dca\u200d\u0dba \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0dc3\u0dd2\u0dba \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0d82 \u0dca\u0dba\u0daf\u0db1\u0dca\u200d\u0dba \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd2\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2 \u0dc0 \u0dca\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0dc0\u0db0\u0dca\u200d \u0db1\u0dca\u200d\u0dba\u0dca\u0dba\u0db1\u0dca \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u200d\u0dba \u0dca\u0db8\u0dcf\u0db1\u0dca \u0d9a\u0dcf \u0dbb\u0dd4\u0dab\u0dd2\u0d9a\u0dcf\u0dc0 \u0d89\u0dbd\u0dca\u0dbd\u0d82 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \