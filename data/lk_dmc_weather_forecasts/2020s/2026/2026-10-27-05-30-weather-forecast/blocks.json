    "text": "\u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca \u0dc1 10 \u0dad\u0dca 20 \u0dad\u0dca \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba\u0dd0\u0dca\u0d9c\u0db1\u0dca\u200d\u0dba\u0dc4\u0dd2\u0dbb \u0dca\u0dda\u0dc1 \u0dc1 80 \u0dad\u0dca 95 \u0dad\u0dca \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0dc3\u0dd4\u0dc5\u0dca\u0dda \u0dca\u0dda\u0d9c\u0dba \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0\u0dba\u0da7 \u0d9a\u0dd2\u0dca\u0dbd\u0d82\u0ddd\u0db8\u0dd3\u0da7\u0dbb 80-100 \u0daf\u0d9a\u0dc0 \u0d89\u0dc4\u0dcf\u0dc5 \u0dba \u0dc4\u0dcf\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb, \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dad\u0daf \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dba \u0dc4\u0dcf\u0dd0\u0d9a\u0dcf. \u0d91\u0dca\u0db8\u0dcf\u0db1\u0dca\u0db8\u0dcf \u0dca\u0db8\u0dcf\u0db8\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0dbb\u0dc5 \u0d8b\u0dc3 \u0db8\u0dd3\u0da7\u0dbb\u0dca (3.0 \u2013 4.0) \u0d9a \u0db4\u0db8\u0dcf\u0dab \u0d89\u0dc4\u0dcf\u0dc5 \u0dba \u0dca\u0db8\u0dca \u0dc4\u0dcf\u0dd0\u0d9a\u0dd2\u0dba \u0dc0\u0d9a \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dca\u200d\u0dba \u0d85\u0dad\u0dbb \u0dca\u0db8\u0dcf\u0db8\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1 \u0d89\u0dad \u0dbb\u0dc5\u0dd4 \u0dc0\u0dd2\u0dba \u0dc4\u0dcf\u0dd0\u0d9a\u0dcf. \u0d91\u0db8\u0dcf\u0db1\u0dd2\u0dc3 \u0d91\u0db8\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0db1\u0dca\u200d\u0dba\u0dd0\u0dc0\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0dca\u0daf\u0db1\u0dca\u200d\u0dba \u0dad\u0dd4\u0dbb\u0dd4 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd4\u0d9a\u0dcf \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc0\u0dc5\u0d9a\u0dd2\u0db1\u0dca\u200d\u0dba \u0dca\u0dbd\u0d82\u0dc3\u0dad\u0dca \u0d91\u0db8\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd2\u0d9a\u0dcf \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dbd\u0d82 \u0dca\u0dba\u0dca\u0daf\u0db1\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0da2 \u0dc0\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0dca\u0dda\u0dc1 \u0d9a\u0dcf\u0dbb \u0dba \u0dad\u0dca\u200d\u0dbb\u0dcf \u0d9a\u0dcf\u0dbb\u0db1\u0dca\u200d\u0dba \u0dca\u0dbd\u0d82\u0dc3\u0dad\u0dca \u0d8b\u0db4\u0dca\u0daf\u0dc3\u0dca \u0dca\u0daf\u0db1\u0dd4 \u0dbd\u0d82\u0dd0\u0dca\u0db6\u0dca. \u0dca\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0dca\u0dba\u0db1\u0dca \u0d9a\u0dcf \u0dbd\u0d82\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0daf \u0dca\u0daf\u0db4 \u0dbb\u0dca\u0dad\u0dca\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dcf\u0dbb\u0db1\u0dd4 \u0dbd\u0d82\u0db6\u0db1\u0dca\u200d\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d85\u0db1\u0dca\u200d\u0dba \u0dc0\u0dd0\u0d9a\u0dd2 \u0dc3\u0dc4\u0dcf \u0db1\u0dd2\u0dca\u0dda\u0daf\u0db1\u0dca\u200d\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0dc0\u0db0\u0dca\u200d \u0db1\u0dca\u200d\u0dba\u0dca\u0dba\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0\u0db1\u0dca\u200d\u0dba \u0dca\u0dbd\u0d82\u0dc3 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd4\u0d9a\u0dcf \u0db4\u0dca\u200d\u0dbb\u0da2 \u0dc0\u0dca\u0d9c\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0d82 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0d82\u0dd0\u0dca\u0db6\u0dca. \u0dc0\u0dd0\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba:",
    "fonts": [
