    "bbox": [
      58.56,
      509.71,
      537.89,
      580.9
    ],
    "text": "Issued at 04.00 p.m. on 19 October 2026 Due to the development of an atmospheric disturbance in the lower atmosphere in the vicinity of Sri Lanka, showery condition is expected to be enhanced across the island from tomorrow evening.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      6.960000038146973,
      12.0,
      12.479999542236328,
      12.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      584.56,
      453.05,
      606.1
    ],
    "text": "Showers or thundershowers will occur in most parts of the island after 1.00 p.m.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      609.88,
      538.29,
      648.22
    ],
    "text": "Fairly heavy falls above 75 mm are likely at some places in Northern, North-central, Central and Uva provinces and in Trincomalee district.",
    "fonts": [
      "Calibri",
      "Calibri,Bold",
      "Iskoola Pota,Bold"
    ],
    "sizes": [
      6.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      651.01,
      537.84,
      689.02
    ],
    "text": "Showers may occur in the coastal areas of the Western and Northern provinces and Puttalam district during the morning.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      3.0,
