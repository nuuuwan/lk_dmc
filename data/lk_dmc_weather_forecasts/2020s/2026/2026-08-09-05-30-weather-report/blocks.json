  {
    "page_number": 2,
    "bbox": [
      49.94,
      324.1,
      550.74,
      359.26
    ],
    "text": "Wind speed can exceed 60 kmph at times in the sea areas off the coast extending from Matara to Pottuvil via Hambantota.",
    "fonts": [
      "Calibri",
      "Calibri-Bold",
      "Iskoola Pota"
    ],
    "sizes": [
