    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      457.37,
      550.63,
      554.23
    ],
    "text": "Issued at 2.00 p.m. on 29 June 2026 Showers will occur at times in Western, Sabaragamuwa and North-western provinces and in Galle, Matara, Kandy and Nuwara-Eliya districts. Fairly heavy falls above 50 mm are likely at some places in these areas.",
    "fonts": [
      "Calibri",
      "Calibri-Bold"
    ],
    "sizes": [
      12.0,
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      558.28,
      550.64,
      599.11
    ],
    "text": "Showers or thundershowers may occur at several places in Uva province and in Ampara and Batticaloa districts after 2.00 p.m.",
    "fonts": [
      "Calibri",
      "Iskoola Pota"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      603.16,
      550.71,
      643.99
    ],
    "text": "Strong winds of about (40-50) kmph can be expected at times over Western, Sabaragamuwa, Central, Southern, North-central and Northwestern provinces and in Trincomalee district.",
    "fonts": [
      "Calibri",
      "Calibri-Bold"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      648.16,
      550.25,
      705.63
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
