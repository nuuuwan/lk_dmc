    ],
    "sizes": [
      12.0,
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      496.72,
      548.09,
      538.87
    ],
    "text": "Several spells of showers will occur in Western and Sabaragamuwa provinces and in Kandy, Nuwara-Eliya, Galle and Matara districts.",
    "fonts": [
      "Calibri",
      "Calibri-Bold"
    ],
    "sizes": [
      9.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      542.29,
      316.2,
      562.75
    ],
    "text": "A few showers will occur in North-western province.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      566.17,
      550.64,
      603.43
    ],
    "text": "Showers or thundershowers may occur at a few places in Ampara, Monaragala and Batticaloa districts after 2.00 p.m.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      606.85,
      380.06,
      627.31
    ],
    "text": "Mainly dry weather will prevail over the other areas of the island.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      630.73,
      550.7,
      684.94
    ],
    "text": "Fairly strong winds of about (30-40) kmph can be expected at times over Western slopes of the Central hills, North-central and North-western provinces and in Trincomalee, Hambantota and Matale Districts.",
    "fonts": [
      "Calibri",
      "Calibri-Bold"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.32,
      688.84,
      550.25,
      745.11
