    "text": "\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dc0 \u0d86\u0dc3\u0db1\u0dca\u0db1\u0d9c\u0dda \u0dd9\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0da9\u0dd4 \u0db4\u0dd3\u0da9\u0db1 \u0d9a\u0dbd\u0dcf\u0dd9\u0dba \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0d9c\u0db1\u0db1\u0dca \u0d89\u0dc0\u0dad\u0da7, \u0d91\u0db1\u0dda \u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0d9c\u0daf\u0dc3\u0da7 \u0dd9\u0db8\u0db1\u0dca \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca \u0dd9\u0dc0\u0dad\u0dd3. \u0d9c\u0d9a\u0d9c\u0dc3\u0dca \u0d9c\u0dc0\u0dad\u0dad\u0dca, \u0d9c\u0db8\u0db8 \u0dd9\u0dda\u0db0\u0dca\u200d\u0dad\u0dd2\u0d9c\u0dda \u0db6\u0dbd\u0dd9\u0dd1\u0db8 \u0d85\u0daf \u0daf\u0dd2\u0db1\u0d9c\u0dda\u0daf\u0dd3\u0dad\u0dca \u0dd9\u0dc0\u0dad\u0dd2\u0db1\u0dd4 \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0db6\u0dbd\u0dcf\u0d9c\u0dd9\u0dcf\u0d9c\u0dbb\u0dcf\u0dad\u0dca\u0dad\u0dd4\u0d9c\u0dda.",
