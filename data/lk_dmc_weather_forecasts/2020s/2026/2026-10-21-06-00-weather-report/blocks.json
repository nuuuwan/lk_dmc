    ],
    "text": "WEATHER FORECAST FOR 21 OCTOBER 2026",
    "fonts": [
      "Calibri",
      "Calibri,Bold",
      "Iskoola Pota"
    ],
    "sizes": [
      0.9599999785423279,
      12.0,
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      202.49,
      525.43,
      413.78,
      537.91
    ],
    "text": "Issued at 05.30 a.m. on 21 October 2026.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0,
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      541.69,
      555.05,
      615.19
    ],
    "text": "A low level atmospheric disturbance near Sri Lanka is likely to develop into a low-pressure area within the next 24 hours. Under the influence of this system, an increase in rainfall is expected over the island and the deep and shallow sea areas around the island during the next few days from today (21).",
    "fonts": [
      "Calibri,Bold",
      "Times New Roman"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      634.03,
      554.35,
      662.95
    ],
    "text": "The general public, as well as the naval and fishing communities, are requested to be attentive to the future forecasts and bulletins issued by the Department of Meteorology in this regard.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      681.82,
      555.05,
      710.62
    ],
    "text": "Showers or thundershowers will occur at times over most parts of the island. The cloudy skies can be expected over most parts of the island.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      714.28,
      552.53,
      754.18
    ],
    "text": "Heavy falls above 100 mm are likely at some places in Western, Sabaragamuwa, Central, North-western, Northern and Southern provinces and in Anuradhapura district.",
    "fonts": [
      "Calibri",
      "Calibri,Bold",
      "Iskoola Pota,Bold"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      757.84,
      554.52,
      797.62
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      6.960000038146973,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      801.67,
      554.47,
      842.62
    ],
    "text": "Misty conditions can be expected at some places in Central and Uva provinces during the early hours of the morning.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
