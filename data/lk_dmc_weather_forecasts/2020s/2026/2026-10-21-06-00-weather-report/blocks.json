  {
    "page_number": 1,
    "bbox": [
      59.16,
      544.51,
      568.58,
      590.11
    ],
    "text": "A low level atmospheric disturbance near Sri Lanka is likely to develop into a low-pressure area within the next 24 hours. Under the influence of this system, an increase in rainfall is expected over the deep and shallow sea areas around the island during the next few days from today (21).",
    "fonts": [
      "Calibri,Bold",
      "Times New Roman"
    ],
    "sizes": [
