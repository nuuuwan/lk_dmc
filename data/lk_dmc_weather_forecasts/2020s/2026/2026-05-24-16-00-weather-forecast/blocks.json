    "page_number": 0,
    "bbox": [
      58.56,
      620.26,
      373.34,
      637.27
    ],
    "text": "A few showers will occur in Anuradhapura and Mannar districts.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
