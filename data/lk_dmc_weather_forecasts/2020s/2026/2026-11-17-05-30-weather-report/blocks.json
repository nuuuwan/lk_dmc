    "text": "\u0d91\u0db8\u0dcf\u0db1\u0dd2\u0dc3 , \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dca \u0dc1 05 \u0dad\u0dca 18\u0dad\u0dca \u0d85\u0dad\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba\u0dd0\u0db1\u0d9c\u0db1\u0dca\u200d\u0dba\u0dc4\u0dd2\u0dbb \u0db1\u0dda\u0dc1 \u0dc1 80\u0dad\u0dca 95\u0dad\u0dca \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0dc3\u0dc4\u0dcf \u0d9a\u0dcf\u0db1\u0dca\u0d9a\u0dcf\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0dbb\u0dba \u0dc3\u0dd2\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab \u0db8\u0dcf\u0dbd\u0d82\u0dba \u0dc3\u0dc4\u0dcf \u0db8\u0dcf\u0da9\u0d9a\u0dcf\u0dbd\u0d82\u0db4\u0dd4\u0dc0 \u0dc4\u0dcf\u0dbb\u0dc4\u0dcf \u0db1\u0db4 \u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dca\u0dc0 \u0db1\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0dda\u0db1\u0db6\u0db1\u0dca \u0dc0\u0db1\u0dca\u200d\u0dba \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dc0\u0dbd\u0d82\u0dad\u0dca \u0db1\u0dca\u200d\u0dba\u0dd0\u0dc0\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0db1\u0daf\u0db1\u0dca\u200d\u0dba\u0dad\u0dd4\u0dbb\u0dd4 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd4\u0d9a\u0dcf \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc0\u0dd0\u0dbd\u0d82\u0d9a\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dca\u200d\u0dba \u0db1\u0dbd\u0d82\u0dc3 \u0daf\u0dd0\u0db1\u0dd4\u0db8\u0dca \u0db1\u0daf\u0db1\u0dd4 \u0dbd\u0d82\u0dd0\u0db1\u0dda. \u0d91\u0db8\u0dcf \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dc0\u0dbd\u0d82 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4\u0dcf \u0db1\u0dca\u200d\u0dba \u0dc0\u0dd2\u0d9a\u0dcf \u0d9a\u0dcf\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dbd\u0d82 \u0db1\u0dba\u0db1\u0daf\u0db1\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0da2 \u0dc0\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0db1\u