  {
    "page_number": 0,
    "bbox": [
      194.57,
      506.35,
      427.46,
      519.31
    ],
    "text": "Issued at 04.00 p.m. on 21 September 2026",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0,
      12.479999542236328,
      12.960000038146973
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      521.08,
      538.34,
      661.66
    ],
    "text": "The low-pressure area located over the Andaman Sea region of the Bay of Bengal, northeast of the island, is expected to further intensify into a depression within the next 24 hours. Although this system will not have a direct impact on Sri Lanka, the prevailing rainy conditions in the southwestern part of the island are expected to continue due to the wind flow towards the system. Showers or thundershowers will occur at times in the Western, Sabaragamuwa, Central and North-western provinces and in Galle and Matara Districts. Heavy falls about 100 mm are likely at some places in the above areas.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      8.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      664.18,
      463.97,
      679.9
    ],
    "text": "Several spells of showers may occur in North-central province and Mannar district.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      682.42,
      538.32,
      714.94
    ],
    "text": "Showers or thundershowers will occur at several places in Uva province and in Batticaloa and Ampara districts after 2.00 p.m.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      717.97,
      538.27,
      791.59
    ],
    "text": "Strong winds of about (40-50) kmph can be expected at times over Western slopes of the Central hills, North-central and North-western provinces and in Trincomalee, Hambantota and Matale Districts. The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      3.0,
      9.960000038146973,
      12.0
    ]
  },
