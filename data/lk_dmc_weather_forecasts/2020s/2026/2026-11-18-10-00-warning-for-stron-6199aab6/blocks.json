    "text": "\u0db6\u0da7\u0dc4\u0dd2\u0dbb \u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db8\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0db8\u0db6\u0dcf\u0d9a\u0dca\u0d9a \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0db8\u0dda \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0d9a\u0dbb\u0db1 \u0db6\u0dc4\u0dd4\u0daf\u0dd2\u0db1 \u0db0\u0dd3\u0dc0\u0dbb \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0dc3\u0dc4 \u0d9a\u0db1\u0dca\u0dad\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dbb\u0dba \u0dc3\u0dd2\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0dcf \u0db8\u0db4\u0dcf\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db8\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db8\u0db6\u0db1\u0dca\u0dad\u0dc0\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1 \u0dc3\u0db3\u0dc4\u0dcf.",
