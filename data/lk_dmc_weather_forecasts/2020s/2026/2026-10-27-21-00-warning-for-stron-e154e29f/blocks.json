    "text": "\u0db6\u0dc4\u0dd4\u0daf\u0dd2\u0db1 \u0db0\u0dd3\u0dc0\u0dbb \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0dc3\u0db3\u0dc4\u0dcf \u0db6\u0da7\u0dc4\u0dd2\u0dbb-\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db8\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0db8\u0db6\u0dcf\u0d9a\u0d9a \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u201c\u0d94\u0dbb\u0dca\u0db1\u0db6\u0dca\u201d (Arnab) \u0d89\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0 \u0d85\u0daf \u0daf\u0dd2\u0db1 (2026 \u0d94\u0d9a\u0db8\u0dad\u0ddd\u0db6\u0dbb\u0dca 27) \u0db4. \u0dc0 02.30 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dcf\u0d82\u0dc1 16.2 \u0dc3\u0dc4 \u0db1\u0dd0\u0db8\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dda\u0dc1\u0dcf\u0d82\u0dc1 83.3 \u0d86\u0dc3\u0db1\u0dca\u0dad\u0db1\u0db8\u0dda \u0d9a\u0db1\u0dca\u0dad\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dbb\u0db8\u0dda \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2. \u0db8\u0dd3. 800 \u0db4\u0db8\u0dab \u0d8a\u0dc1\u0dcf\u0db1 \u0db8\u0daf\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0db8\u0d9a\u0db1\u0dca\u0dad\u0dbb\u0d9c\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd4\u0db1\u0dd2. \u0db8\u0db8\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba \u0d9a\u0dd2\u0dc4\u0dd2\u0db4\u0dba \u0dad\u0dd4\u0dc5 \u0db8\u0db6\u0dcf\u0db8\u0dc4\u0ddd \u0daf\u0dd4\u0dbb\u0da7 \u0db6\u0da7\u0dc4\u0dd2\u0dbb-\u0dc0\u0dba\u0db9 \u0db8\u0daf\u0dc3\u0da7\u0dad\u0dca, \u0d89\u0db1\u0dca\u0dad\u0db4\u0dc3\u0dd4 \u0dc0\u0dba\u0db9 \u0db8\u0daf\u0dc3\u0da7\u0dad\u0dca \u0d9c\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1\u0dd4 \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0d85\u0db8\u0dda\u0d9a\u0dca\u0dcf \u0db8\u0d9a\u0db8\u0dbb\u0dca. 2026 \u0d94\u0d9a\u0db8\u0dad\u0ddd\u0db6\u0dbb\u0dca 28 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0db8\u0db4. \u0dc0. 2.00 \u2013 4.00 \u0d85\u0dad\u0dbb \u0d9a\u0dcf\u0dbd\u0dba \u0dad\u0dd4\u0dbb, \u0db8\u0db8\u0dba '\u0d89\u0dad\u0dcf \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0d9a' \u0db8\u0dbd\u0dc3 \u0d89\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dcf\u0db8\u0dda \u0d86\u0db1\u0dca\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dca \u0d94\u0dc3\u0dca\u0db8\u0dc3\u0dca \u0d91\u0dbb\u0da7 \u0db8\u0d9c\u0dcf\u0da9\u0db6\u0dd2\u0db8\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc0\u0db1\u0dd4 \u0d87\u0dad. \u0d91\u0db8 \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0db8\u0dda\u0daf\u0dd3 \u0dc3\u0dd4\u0dc5\u0db8\u0dda \u0d8b\u0db4\u0dbb\u0dd2\u0db8 \u0db8\u0dda\u0d9c\u0dba \u0db4\u0dd0\u0dba\u0da7 \u0d9a\u0dd2\u0db8\u0dbd\u0ddd\u0db8\u0dd3\u0da7\u0dbb 125\u0dad\u0dca 135\u0dad\u0dca \u0d85\u0dad\u0dbb \u0db4\u0dc0\u0dad\u0dd2\u0db1\u0dd4 \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0d85\u0db8\u0dda\u0d9a\u0dca\u0dcf \u0db8\u0d9a\u0db8\u0dbb\u0db1 \u0d85\u0dad\u0dbb, \u0dc3\u0dd4\u0dc5\u0db8\u0dda \u0db8\u0dda\u0d9c\u0dba \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0da7 \u0db4\u0dd0\u0dba\u0da7 \u0d9a\u0dd2\u0db8\u0dbd\u0ddd\u0db8\u0dd3\u0da7\u0dbb 150 \u0daf\u0d9a\u0dc0\u0dcf \u0d89\u0dc4\u0dc5 \u0dba\u0dcf \u0dc4\u0dd0\u0d9a\u0dd2\u0dba.",
