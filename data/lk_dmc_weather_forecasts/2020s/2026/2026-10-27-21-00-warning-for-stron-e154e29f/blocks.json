      56.66,
      172.82,
      379.22,
      217.58
    ],
    "text": "Issued by the Natural Hazards Early Warning Centre Issued at 09.00 p.m. 27 October 2026, valid for the next 24 hours.",
    "fonts": [
      "Calibri",
      "Calibri,Bold",
      "Iskoola Pota"
    ],
    "sizes": [
      0.9599999785423279,
