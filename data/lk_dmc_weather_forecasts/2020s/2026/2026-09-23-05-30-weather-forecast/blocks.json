    ]
  },
  {
    "page_number": 0,
    "bbox": [
      194.93,
      498.79,
      421.22,
      511.27
    ],
    "text": "Issued at 05.30 a.m. on 23 September 2026.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      12.0,
      12.479999542236328
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      515.56,
      546.6,
      591.31
    ],
    "text": "The Depression over the Northwest Bay of Bengal, to the northeast of Sri Lanka, has intensified into a Deep Depression. Although this system will not have a direct impact on Sri Lanka, the prevailing rainy conditions in the southwestern part of the island are expected to continue due to the wind flow towards the system.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      9.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      594.73,
      554.99,
      648.91
    ],
    "text": "Showers or thundershowers will occur at times in the Western, Sabaragamuwa, Central and North-western provinces and in Galle and Matara Districts. Heavy falls above 100 mm are likely at some places in the above areas.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      652.21,
      463.97,
      672.79
    ],
    "text": "Several spells of showers may occur in North-central province and Mannar district.",
    "fonts": [
      "Calibri"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      681.13,
      554.81,
      714.94
    ],
    "text": "Strong winds of about (40-50) kmph can be expected at times over Western slopes of the Central hills, North-central and North-western provinces and in Trincomalee, Hambantota and Matale Districts.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      2.0399999618530273,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      718.87,
      554.84,
      939.48
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      8.039999961853027,
      9.960000038146973,
      11.039999961853027,
      12.0
    ]
  },
