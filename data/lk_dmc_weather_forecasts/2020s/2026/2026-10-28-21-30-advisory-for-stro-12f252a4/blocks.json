    ],
    "text": "\u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dbd\u0dd2\u0db8\u0dad\u0dca \u0dc0\u0db1\u0dca\u0dad\u0db1! \u0dc0\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0dc0\u0db6\u0dcf\u0d9a\u0d9a \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dda \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u201c\u0d94\u0dbb\u0dca\u0db1\u0db6\u0dca\u201d (Arnab) \u0da0\u0dab\u0dca\u0da9 \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0 \u0d85\u0daf \u0daf\u0dd2\u0db1 (2026 \u0d94\u0d9a\u0dc0\u0dad\u0ddd\u0db6\u0dbb\u0dca 28) \u0db4.\u0dc0. 05.30 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u201c\u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0d9a\u201d \u0daf\u0d9a\u0dc0\u0dcf \u0daf\u0dd4\u0dbb\u0dca\u0dc0\u0dbd \u0dc0\u0dd3, \u0d8b\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dcf\u0d82\u0dc1 17.0 \u0dc3\u0dc4 \u0db1\u0dd0\u0dc0\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0dc0\u0dda\u0dc1\u0dcf\u0d82\u0dc1 81.7 \u0d86\u0dc3\u0db1\u0dca\u0dad\u0db1\u0dc0\u0dda \u0dc0\u0d9a\u0db1\u0dca\u0dad\u0dbb\u0d9c\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dd4\u0db1\u0dd2. \u0dc0\u0db8\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba 24 \u0dd4\u0dc5 \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0daf\u0dd4\u0dbb\u0dca\u0dc0\u0dbd \u0dc0\u0dc0\u0db8\u0dd2\u0db1\u0dca\u0dad \u0d8b\u0dd4\u0dbb\u0da7 \u0db6\u0dbb\u0dc0 \u0dc0\u0dba\u0db9 \u0dc0\u0daf\u0dc3\u0da7 \u0d9c\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db1 \u0d85\u0dad\u0dbb 2026 \u0d94\u0d9a\u0dc0\u0dad\u0ddd\u0db6\u0dbb\u0dca 28 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0db4. \u0dc0. 11.30 \u0db4\u0db8\u0dab \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db4\u0dd3\u0da9\u0db1 \u0d85\u0dc0\u0db4\u0dcf\u0dad\u0dba\u0d9a \u0daf\u0d9a\u0dc0\u0dcf \u0daf\u0dd4\u0dbb\u0dca\u0dc0\u0dbd \u0dc0\u0db1\u0dd4 \u0d87\u0dad. \u0db4\u0dc4\u0dad \u0dc3\u0dd2\u0dad\u0dd2\u0dba\u0dc0\u0db8\u0dca \u201cAdvisory\u201d \u0d9a\u0dcf\u0dab\u0dca\u0da9\u0dba \u0dba\u0da7\u0dc0\u0dad\u0dca \u0dbd\u0d9a\u0dd4\u0dab\u0dd4 \u0d9a\u0dbb\u0d87\u0dad\u0dd2 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dd4\u0dc5\u0dc0\u0dda \u0dc0\u0dda\u0d9c\u0dba \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (55-65) \u0daf\u0d9a\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0db1 \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd2\u0da7 \u0dbb\u0dc5\u0dd4 \u0dc0\u0dc4\u0ddd \u0d89\u0dad\u0dcf \u0dbb\u0dc5\u0dd4 \u0dc0\u0dda. \u0dc0\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0dc0\u0db6\u0dcf\u0d9a\u0d9a \u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dbd \u0db6\u0dc4\u0dd4\u0daf\u0dd2\u0db1 \u0db0\u0dd3\u0dc0\u0dbb \u0dc0\u0db6\u0ddd\u0da7\u0dca\u0da7\u0da7\u0dd4 \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0d9a\u0dcf\u0dbb\u0d9a\u0db8\u0dca \u0dc0\u0dd0\u0dc5\u0dd0\u0d9a\u0dc0\u0dd3\u0db8 \u0dc3\u0db3\u0dc4\u0dcf \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0d85\u0db1\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8 \u0d89\u0dc0\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0dd0\u0dc0\u0db6\u0dca.",
