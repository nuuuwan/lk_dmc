  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      508.06,
      537.87,
      559.27
    ],
    "text": "Due to the active southwest monsoon, the prevailing rainy and windy conditions over the southwestern parts of the island are expected to intensify from tomorrow and continue for the next few days.",
    "fonts": [
      "Calibri,Bold",
      "Iskoola Pota,Bold"
    ],
    "sizes": [
      3.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      562.3,
      538.37,
      664.66
    ],
    "text": "For next 36 hours: Showers or thundershowers will occur at times in Western, Sabaragamuwa, and North-western provinces and Kandy, Nuwara-Eliya, Galle and Matara districts. Cloudy skies will prevail over these areas. Heavy falls above 100 mm are likely at some places in Western and Sabaragamuwa provinces and in Kandy, Nuwara-Eliya and Galle districts.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      3.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      667.57,
      538.27,
      702.46
    ],
    "text": "Showers or thundershowers may occur at a few places in Ampara, Batticaloa, and Monaragala districts after 2.00 p.m.",
    "fonts": [
      "Calibri",
      "Iskoola Pota"
    ],
    "sizes": [
      3.0,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      705.88,
      538.29,
      743.26
    ],
    "text": "Strong winds of about (40-50) kmph can be expected at times over North-central, Sabaragamuwa, Southern, Central and North-western provinces.",
    "fonts": [
      "Calibri",
      "Calibri,Bold"
    ],
    "sizes": [
      5.039999961853027,
      12.0
    ]
  },
  {
    "page_number": 0,
    "bbox": [
      58.56,
      745.78,
      537.94,
      778.3
    ],
    "text": "The general public is kindly requested to take adequate precautions to minimize damage caused by temporary localized strong winds and lightning during thundershowers.",
    "fonts": [
      "Calibri,Bold"
    ],
    "sizes": [
      0.9599999785423279,
      12.0
    ]
  },
