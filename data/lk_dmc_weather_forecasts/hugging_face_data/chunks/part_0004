\u0dc4 83.5E \u0d86\u0dc3\u0db1\u0dca\u0db1\u0d9c\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dcf \u0d87\u0dad. \u0d9c\u0db8\u0db8 \u0dd9\u0dda\u0db0\u0dad\u0dd2\u0d9c\u0dda \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0d9c\u0dc4\u0dda\u0dad\u0dd4\u0d9c\u0dc0\u0db1\u0dca \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0daf\u0dd2\u0db1\u0dc0\u0dbd\u0daf\u0dd3 \u0d9c\u0db6\u0dcf\u0d82\u0dd9\u0dcf\u0dbd \u0d9c\u0db6\u0dcf\u0d9a\u0d9a \u0dd9\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dc0\u0dbd \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0dcf\u0d82 \u0dc3\u0dc4 \u0dad\u0daf \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dbb\u0dc5\u0dd4 \u0dc0\u0dd3\u0d9c\u0dda \u0dc4\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0\u0d9a \u0dd9\u0dc0\u0dad\u0dd3.\n\n\u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0d9c\u0daf\u0dd9\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0dda\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d9c\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0dc0 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db1\u0dd2\u0d9c\u0dda\u0daf\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3 \u0dc3\u0dd2\u0dba \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0dba \u0d9c\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1 \u0d9c\u0dbd\u0dc3 \u0daf \u0db0\u0dd3\u0dc0\u0dbb \u0dc4\u0dcf \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0d9c\u0dd9\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0d9c\u0dda. \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba: EQ - 15N, 80E-85E : \u0db6 \u0ddc\u0db6 \u0ddd \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1\u0dc0\u0dbd \u0dc0\u0dd0\u0dc3\u0dd2 \u0db6 \u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2. EQ - 18N, 85E-100E : \u0db6 \u0ddc\u0db6 \u0ddd \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1\u0dc0\u0dbd \u0dc0\u0dd0\u0dc3\u0dd2 \u0db6 \u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2. \u0db6\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1 : \u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0dad\u0dd0\u0db1 \u0dc0\u0dd0\u0dc3\u0dd2 \u0db6 \u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2.\n\n\u0dc3\u0dd4\u0dc5\u0dcf\u0d82 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba: EQ-08N, 80E-88E : \u0db1\u0dd2\u0dbb\u0dd2\u0dad \u0db6\u0dd9\u0dc3\u0dd2\u0db1\u0dca / \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (30-40); \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 60 \u0dd9\u0d9a\u0dca\u0dc0\u0ddc. 08N-15N, 80E-90E : \u0dc0\u0ddc\u0db8\u0ddc\u0dc0\u0dbb\u0dca\u0dad / \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (25-35). EQ-10N, 88E-95E : \u0dd9\u0d9a\u0dd4\u0dab \u0dc3\u0dd2\u0da7 \u0db1\u0dd2\u0dbb\u0dd2\u0dad \u0dd9\u0d9a\u0dca\u0dc0\u0ddc \u0dc0\u0db1 \u0daf\u0dd2\u0dc1\u0ddc\u0dc0\u0dbd\u0dd2\u0db1\u0dca / \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (30-40). Other sea areas : \u0d9c\u0dd2\u0db1\u0dd2\u0db6 \u0ddc\u0dab \u0db6\u0dd9\u0dc3\u0dd2\u0db1\u0dca \u0db6 \u0ddd \u0db1\u0dd2\u0dc1\u0da0\u0dd2\u0dad \u0daf\u0dd2\u0dc1\u0ddc\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0db6\u0dad\u0ddc\u0dbb\u0dc0 / \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (20-30).\n\n\u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0dcf\u0d82\u0d9a\u0dcf\u0dc0\u0da7 \u0d8a\u0dc3\u0dcf\u0db1 \u0d9c\u0daf\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dcf \u0d87\u0dad\u0dd2 \u0d85\u0da9\u0dd4 \u0db4\u0dd3\u0da9\u0db1 \u0d9a\u0dbd\u0dcf\u0dd9\u0dba \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dd9\u0dc0\u0dad\u0dd3. \u0d9c\u0db8\u0db8 \u0dd9\u0dda\u0db0\u0dad\u0dd2\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0daf\u0dd2\u0d