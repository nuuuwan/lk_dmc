\u0dc0 \u0dc3\u0dd2\u0da7 \u0d9a\u0dd2\u0d9c\u0dbd\u0ddd\u0db8\u0dd3\u0da7\u0dbb\u0dca 110 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0d8a\u0dc3\u0dcf\u0db1 \u0d9c\u0dd9\u0dc3\u0dd2\u0db1\u0dca \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dcf \u0dad\u0dd2\u0db6\u0dd4\u0dab\u0dd2. \u0d91\u0dba \u0dc0\u0dba\u0db9 \u0d9c\u0dd9\u0dc3\u0da7 \u0dd9\u0db8\u0db1\u0dca \u0d9a\u0dbb \u0d9c\u0dc4\u0da7 (2026 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 10) \u0daf\u0dd2\u0db1 \u0dc3\u0dc0\u0dc3\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dda\u0daf\u0dd3, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0dba\u0dcf\u0db4\u0db1\u0dba \u0d85\u0dad\u0dbb \u0dc1\u0dca\u200d\u0dbb\u0dd3 \u0dbd\u0d82\u0d9a\u0dcf \u0d9c\u0dc0\u0dbb\u0dc5 \u0dad\u0dd3\u0dbb\u0dba \u0dc4\u0dbb\u0dc4\u0dcf \u0dd9\u0db8\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0da7 \u0d9c\u0db6\u0dcf\u0d9c\u0dc4\u0ddd \u0daf\u0dd4\u0dbb\u0da7 \u0d89\u0da9 \u0d87\u0dad.\n\n\u0d9c\u0dd0\u0db9\u0dd4\u0dbb\u0dd4 \u0db4\u0dd3\u0da9\u0db1 \u0d85\u0dc0\u0db4\u0dcf\u0dad\u0dc0\u0dda \u0d9c\u0db8\u0db1\u0dca \u0db8\u0dcf\u0dbb\u0dca\u0d9c\u0dba. \u0db8\u0dd4\u0dbd\u0dcf\u0dc1\u0dca\u200d\u0dbb\u0dba: RSMC\n\nPage 2 of 5\n\n\u0d9c\u0dd9\u0dcf\u0da9\u0db6\u0dd2\u0db8 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dba \u0dc3\u0dd9\u0dc4\u0dcf : \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0daf\u0dd2\u0db1 \u0dad\u0dd4\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dd9 \u0dc3\u0dd4\u0dc5\u0d82 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dd9 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8.\n\n\u0db4\u0dc5\u0dcf\u0dad \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 09 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 10 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 11\n\n\u0d8b\u0dad\u0dd4\u0dbb\n\n\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (50-60) \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d89\u0dad\u0dcf \u0dad\u0dd9 \u0dc3\u0dd4\u0dc5\u0d82 \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dc4\u0db8\u0db1 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 70 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(50-60) \u0db4\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(30-40) \u0db4\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0dbb\u0db8\u0d9a \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0dd4-\u0db8\u0dd0\u0dd9\n\n\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (50-60) \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d89\u0dad\u0dcf \u0dad\u0dd9 \u0dc3\u0dd4\u0dc5\u0d82 \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dc4\u0db8\u0db1 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 70 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(40-50) \u0db4\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0dbb\u0db8\u0d9a \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(30-40) \u0db4\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0dbb\u0db8\u0d9a \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0db1\u0dd0\u0d9c\u0dd9\u0db1\u0dc4\u0dd2\u0dbb\n\n\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (50-60) \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d89\u0dad\u0dcf \u0dad\u0dd9 \u0dc3\u0dd4\u0dc5\u0d82 \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dc4\u0db8\u0db1 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 70 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(40