d4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2. \u0db6\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1 : \u0db4\u0dca\u200d\u0dbb\u0db0\u0ddc\u0db1 \u0dc0\u0dc1\u0db6\u0dd9\u0db1\u0dca \u0dc0\u0dd0\u0dc3\u0dd2 \u0dbb\u0dc4\u0dd2\u0dad.\n\n\u0db8\u0dd4\u0dc4\u0dd4\u0d9c\u0dda \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba:\n\n05N -13N, 80E-100E : \u0dad\u0dbb\u0db8\u0d9a\u0dca \u0dbb\u0dc5\u0dd4. 13N -20N, 80E-95E : \u0db8\u0daf \u0dc0\u0dc1\u0db6\u0dd9\u0db1\u0dca \u0dbb\u0dc5\u0dd4. \u0db6\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1 : \u0dc3\u0ddc\u0db8\u0ddc\u0db1\u0dba \u0dc3\u0da0\u0db7\u0ddc\u0dc0\u0db6\u0dda \u0dc3\u0dd2\u0da7 \u0db8\u0daf \u0dc0\u0dc1\u0db6\u0dd9\u0db1\u0dca \u0dbb\u0dc5\u0dd4.\n\n\u0dc0\u0dd0\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba: \u0db8\u0dca \u0db1\u0dca\u0db6\u0dad\u0ddc\u0da7 \u0dc3\u0dd2\u0da7 \u0db6\u0db4\u0ddc\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0dbb \u0ddc \u0dad\u0dca\u200d\u0dbb\u0dd3\u0d9a\u0dd4\u0dab\u0ddc\u0db8\u0dbd\u0dd9 \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0db6\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db6 \u0db1\u0dca\u0dc0\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1\u0dc0\u0dbd \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9 \u0dd0\u0d9a. \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0dc0\u0da7\u0ddc \u0dc0\u0db1 \u0db6\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dc0\u0dc3\u0da0 \u0d9a\u0ddc\u0dbd\u0db6\u0dda \u0db6 \u0ddd \u0dbb\u0ddc\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0ddc\u0dbd\u0db6\u0dda\u0daf\u0dd3 \u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0dad\u0dd0\u0db1 \u0dc0\u0dd0\u0dc3\u0dd2 \u0db6 \u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dd9 \u0dd0\u0d9a. \u0dc3\u0dd4\u0dc5\u0d9f: \u0dc3\u0dd4\u0dc5\u0d82 \u0d8a\u0dc3\u0ddc\u0db1 \u0daf\u0dd2\u0dc1\u0ddc\u0db6\u0dc0\u0db1\u0dca \u0db8\u0ddc \u0d91\u0dba\u0dd2. \u0dc3\u0dd4\u0dc5\u0db6\u0dda \u0db6\u0dda\u0dd9\u0dd9 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (30-40) \u0db4\u0db8\u0dab \u0db6\u0dda. \u0d9a\u0dc5\u0dd4\u0dad\u0dbb \u0dc3\u0dd2\u0da7 \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0db8 \u0dc3 \u0db8\u0db1\u0dca\u0db1\u0ddc\u0dbb\u0db8 \u0dbb \u0ddc \u0d9a\u0db1\u0dca\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0dbb\u0dd9 \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0dc3 \u0db8\u0dca \u0db1\u0dca\u0db6\u0dad\u0ddc\u0da7 \u0dc3\u0dd2\u0da7 \u0db6\u0db4\u0ddc\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0db6\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db6 \u0db1\u0dca \u0dc0\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dd4\u0dc5\u0db6\u0dda \u0db6\u0dda\u0dd9\u0dd9 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (45-50) \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0dd2\u0dd9 \u0dd0\u0d9a. \u0db8\u0dd4\u0dc4\u0dd4\u0d9c\u0dda \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba:\n\n\u0d9a\u0dc5\u0dd4\u0dad\u0dbb \u0dc3\u0dd2\u0da7 \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0db8 \u0dc3 \u0db8\u0db1\u0dca\u0db1\u0ddc\u0dbb\u0db8 \u0dbb \u0ddc \u0d9a\u0db1\u0dca\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0dbb\u0dd9 \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0dc3 \u0db8\u0dca \u0db1\u0dca\u0db6\u0dad\u0ddc\u0da7 \u0dc3\u0dd2\u0da7 \u0db6\u0db4\u0ddc\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0db6\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db6 \u0db1\u0dca \u0dc0\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dad\u0dbb\u0db8\u0d9a\u0dca \u0dbb\u0dc5\u0dd4 \u0db6\u0dda. \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0db1 \u0dc0\u0da7\u0ddc \u0dc0\u0db1 \u0db6\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dda\u0dc1 \u0db8\u0daf \u0dc0\u0dc1\u0db6\u0dd9\u0db1\u0dca \u0dbb\u0dc5\u0dd4 \u0db6\u0dda.\n\n\u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0dda \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dc0\u0dbd \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a\u0dc0 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0dcf\u0d82 \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb \u0d91\u0dc0\u0dd2\u0da7 \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a\u0dc0 \u0d89\u0dad\u0dcf \u0dbb\u0dc5\u0dd4 \u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a.\n\nPage 2 of 2\n\n\u0d85\u0dbb\u0dcf\u0db6\u0dd2 \u0db8\u0dd4\u0dc4\u0dd4\u0daf"
