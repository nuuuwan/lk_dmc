9\u0dc4\u0dcf : \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0daf\u0dd2\u0db1 \u0dad\u0dd4\u0db1 \u0dc3\u0db3\u0dc4\u0dcf \u0dad\u0dd9 \u0dc3\u0dd4\u0dc5\u0d82 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dd9 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8.\n\n\u0db4\u0dc5\u0dcf\u0dad \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 09 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 10 \u0da2\u0db1\u0dc0\u0dcf\u0dbb\u0dd2 11\n\n\u0d8b\u0dad\u0dd4\u0dbb\n\n\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (50-60) \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d89\u0dad\u0dcf \u0dad\u0dd9 \u0dc3\u0dd4\u0dc5\u0d82 \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dc4\u0db8\u0db1 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 70 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(50-60) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(30-40) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0dd4-\u0db8\u0dd0\u0dd9\n\n\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (50-60) \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d89\u0dad\u0dcf \u0dad\u0dd9 \u0dc3\u0dd4\u0dc5\u0d82 \u0dc3\u0db8\u0d9f \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dc4\u0db8\u0db1 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 70 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dc4\u0dcf\u0dbb\u0dcf\u0dad\u0dca\u0db8\u0d9a \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(40-50) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0dbb\u0db8\u0d9a \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\