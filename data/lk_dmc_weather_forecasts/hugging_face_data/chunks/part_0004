cf\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd3.\n\n\u0db1\u0dd2\u0dbb\u0dd2\u0dad\u0daf\u0dd2\u0d9c \u0dc0 \u0d82\u0d9c\u0dcf\u0dbd \u0dc0 \u0dcf\u0d9a\u0dca\u0d9a \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1\u0dc0\u0dda \u0db4\u0dc0\u0dad\u0dd2\u0db1 \u0d85\u0da9\u0dd4 \u0db4\u0dd3\u0da9\u0db1 \u0d9a\u0dbd\u0dcf\u0db4\u0dc0\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd3\u0db8\n\n\u0d85\u0daf(15) \u0daf\u0dd2\u0db1 \u0daf\u0dad\u0dca\u0dad \u0db8\u0dad \u0db4\u0daf\u0db1\u0db8\u0dca\u0dc0 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba 168 \u0dad\u0dd4\u0dc5 \u0db4\u0dd3\u0da9\u0db1 \u0d85\u0dc0\u0db4\u0dcf\u0dad\u0dba\u0d9a\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dc0\u0dd3\u0dc0\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0dcf\u0dc0\n\n\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba 24 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba\n\n24-48\n\n\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba\n\n48-72\n\n\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba\n\n72-96\n\n\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba\n\n96-120\n\n\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba 120-144\n\n\u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db4\u0dd0\u0dba 144-168\n\n\u0db1\u0dd0\u0dad \u0db1\u0dd0\u0dad \u0d85\u0dc0\u0db8 - \u0db1\u0dd0\u0dad \u0db1\u0dd0\u0dad \u0db1\u0dd0\u0dad \u0dc0\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d\u0dc0\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0dc0\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0dc0\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d85\u0db1\u0dcf\u0dc0\u0dd0\u0d9a\u0dd2 \u0dc3 \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0db1\u0dc0\u0dba\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dd4\u0dc0\u0db1 \u0dc0\u0dbd\u0dc3 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3 \u0db1\u0dcf\u0dc0\u0dd4\u0d9a \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0 \u0d87\u0dd4\u0dc5\u0dd4 \u0db8 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0dc0\u0d9c\u0db1\u0dca\u0dad \u0d89\u0dda\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0dc0\u0dda. \u0db8\u0dd3\u0dc5\u0d9f \u0db1\u0dd2\u0dc0\u0dda\u0daf\u0db1\u0dba 2026 \u0db8\u0dd0\u0dba\u0dd2 16 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0db4.\u0dc0. 3.00 \u0da7 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0dc0\u0d9a\u0dc0\u0dbb\u0dca.\n\nPage 1 of 1\n\nBulletin No: 05 TCA/26/05/15/01 COLOR: Amber\n\nAdvisory for the low pressure area in the vicinity of Sri Lanka. Issued by the Natural Hazards Early Warning Centre, Department of Meteorology. Issued at 3.00 p.m. on 15 May 2026\n\nPLEASE BE AWARE!\n\nAccording to the today\u2019s (May 15th) latest weather analysis, the low-pressure area located northeast of the Sri Lanka, still persist. Therefore, the prevailing showery and windy conditions around the island are expected to continue."
