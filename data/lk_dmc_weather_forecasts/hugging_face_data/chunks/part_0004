 \u0dc4\u0dd0\u0d9a \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0dbb\u0dc4\u0dd2\u0dad \u0d85\u0da9\u0dd4 \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0db8\u0db0\u0dca\u200d\u0dba \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca \u0d85\u0db0\u0dd2 \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0dca\n\nPage 4 of 5\n\n\u0d9c\u0dd9\u0dcf\u0da9\u0db6\u0dd2\u0db8 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dba \u0dc3\u0dd9\u0dc4\u0dcf:\n\n\u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0dc4\u0dcf\u0db1\u0dd2\n\n\u2022 \u0db4\u0dd0\u0dbd\u0dca\u0db4\u0dad\u0dca\u0dc0\u0dbd\u0da7 \u0dc4\u0dcf \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a \u0d89\u0daf\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca\u0dc0\u0dbd\u0da7 \u0dc4\u0dcf\u0db1\u0dd2 \u0dc0\u0dd3\u0db8 . \u2022 \u0dc0\u0dc4\u0dbd\u0dc0\u0dbd \u0d87\u0dad\u0dd2 \u0dad\u0dc4\u0da9\u0dd4 \u0d8b\u0dc5\u0dd4 \u0d86\u0daf\u0dd2\u0dba \u0d9c\u0dd0\u0dbd\u0dc0\u0dd3 \u0dba\u0dcf\u0db8. \u2022 \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dc3\u0dc4 \u0daf\u0dd4\u0dbb\u0d9a\u0dae\u0db1 \u0dbb\u0dd0\u0dc4\u0dd0\u0db1\u0dca \u0dc0\u0dbd\u0da7 \u0dc4\u0dcf\u0db1\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a. \u2022 \u0d9c\u0dc3\u0dca\u0dc0\u0dbd \u0d85\u0dad\u0dd4 \u0d9a\u0dd0\u0da9\u0dd3\u0db8\u0dca \u0dc3\u0dc4 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0d85\u0dc3\u0dbd \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dc1\u0dcf\u0dbd \u0d9c\u0dc3\u0dca \u0d9c\u0dd0\u0dbd\u0dc0\u0dd3 \u0dba\u0dcf \u0dc4\u0dd0\u0d9a. \u2022 \u0dc0\u0dd3 \u0dc0\u0d9c\u0dcf \u0db6\u0dd2\u0db8\u0dca\u0dc0\u0dbd\u0da7,\u0dc0\u0d9a\u0dc0\u0dc3\u0dbd\u0dca, \u0db4\u0dd0\u0dc0\u0db4\u0dcf\u0dbd\u0dca \u0dc0\u0dd0\u0db1\u0dd2 \u0db4\u0dc5\u0dad\u0dd4\u0dbb\u0dd4 \u0dc0\u0d9c\u0dcf\u0dc0\u0db1\u0dca \u0dc0\u0dbd\u0da7\u0daf \u0dc4\u0dcf\u0db1\u0dd2 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a. \u2022 \u0dc0\u0dbb\u0dcf\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0db1\u0dc0\u0dad\u0dcf /\u0dbb\u0db3\u0dc0\u0dcf \u0d87\u0dad\u0dd2 \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0d85\u0d82\u0d9c\u0db1 \u0dc0\u0dbd\u0da7 \u0dc4\u0dcf\u0db1\u0dd2 \u0dc0\u0dd3\u0db8 \u2022 \u0d9a\u0dca\u0dc2\u0dab\u0dd2\u0d9a \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0db1\u0dca \u0d87\u0dad\u0dd2\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a \u2022 \u0dc0\u0dc0\u0dbb\u0dc5\u0dcf\u0dc3\u0db1\u0dca\u0db1 \u0db4\u0dc4\u0dad\u0dca \u0dc0\u0d9c\u0dcf\u0da9\u0db6\u0dd2\u0db8\u0dca \u0db4\u0dca\u200d\u0dbb\u0dc0\u0dda\u0dc1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0da2\u0dbd\u0dc0\u0dba\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a.\n\n\u0d85\u0db1\u0dd4\u0d9c\u0db8\u0db1\u0dba \u0d9a\u0dbd \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0d9c:\n\n\u2022 \u0d9c\u0dc0\u0dbb\u0dbd \u0d86\u0dc3\u0db1\u0dca\u0db1 \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0dc0\u0dbd\u0da7 \u0dd9\u0db8\u0db1\u0dca \u0d9a\u0dd2\u0dbb\u0dd3\u0db8. \u0db6\u0dbd\u0db4\u0dd1\u0db8 \u0d87\u0dad\u0dd2\n\n\u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dc0\u0dbd \u0d85\u0d9c\u0db1\u0d9a\u0dd4\u0dad\u0dca \u0db4\u0daf\u0dd2\u0d82\u0da0\u0dd2\u0d9a\u0dbb\u0dd4\u0dc0\u0db1\u0dca \u0db1\u0dd2\u0dc0\u0dcf\u0dc3 \u0dad\u0dd4\u0dbd\u0da7 \u0dc0\u0dd3 \u0dc3\u0dd2\u0da7\u0dd3\u0db8. \u2022 \u0d9a\u0db3\u0dd4\u0d9a\u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dc0\u0dbd (\u0dc0\u0dd2\u0d9c\u0dc1\u0dca\u0dc2\u0d9c\u0dba\u0db1\u0dca \u0db1\u0dcf\u0dba \u0dba\u0dcf\u0db8\u0dca \u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0db1\u0db8 \u0dc3\u0dc4\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dc0\u0dbd) \u0dc3\u0dc4 \u0dd9\u0d82\u0dd9\u0dcf \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0db4\u0dc4\u0dad\u0dca\n\n\u0db6\u0dd2\u0db8\u0dca \u0dc0\u0dbd \u0da2\u0dd3\u0dc0\u0dad\u0dca \u0dc0\u0db1 \u0da2\u0db1\u0dad\u0dcf\u0dc0 \u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0d9c\u0dba\u0db1\u0dca \u0dc0\u0dd2\u0db8\u0dc3\u0dd2\u0dbd\u0dd2\u0db8\u0dad\u0dca\u0dc0\u0db1\u0dca\u0db1. \u2022 \u0d9a\u0db3\u0dd4\u0d9a\u0dbb \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dc0\u0dbd \u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0db7\u0dcf\u0dc0\u0dd2\u0dad \u0d9a\u0dbb\u0db1\u0dca\u0db1\u0db1\u0dca \u0dc3\u0dc4 \u0dbb\u0dae \u0dc0\u0dcf\u0dc4\u0db1 \u0db4\u0dd9\u0dc0\u0db1\u0dca\u0db1\u0db1\u0dca \u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0d9c\u0dba\u0db1\u0dca\n\n\u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0db1\u0dba \u0d9c\u0dba\u0dcf\u0db8\u0dd4 \u0d9a\u0dbb\u0db1\u0dca\u0db1 \u2022 \u0d9a\u0da9\u0dcf\u0dc0\u0dd0\u0d9c\u0da7\u0db1 \u0dd9\u0dc3\u0dca\u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0dc3\u0dc4 \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0dbb\u0dd0\u0dc4\u0dd0\u0db1\u0dca \u0dc0\u0dbd\u0dd2\u0db1\u0dca \u0d86\u0dbb\u0d9a\u0dca\u0dc2\u0dcf\u0dc0\u0dd3\u0db8. \u2022 \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2 \u0db4\u0dc0\u0dad\u0dca\u0db1\u0dcf \u0d85\u0dc0\u0dc3\u0dca\u0dae\u0dcf\u0dc0\u0dbd \u0dbb\u0dd0\u0dc4\u0dd0\u0db1\u0dca \u0daf\u0dd4\u0dbb\u0d9a\u0dae\u0db1 \u0dc3\u0dc4 \u0dc0\u0dd2\u0daf\u0dd4\u0dbd\u0dd2 \u0d8b\u0db4\u0d9a\u0dbb\u0dab \u0db7\u0dcf\u0dc0\u0dd2\u0dad\u0d9c\u0dba\u0db1\u0dca \u0dc0\u0dd0\u0dc5\u0d9a\u0dd3\u0db8. \u2022 \u0d87\u0dad\u0dd2\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0dba\u0dc4\u0db4\u0dad\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dc0\u0dba \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0dd9 \u0dc0\u0dd2\u0db8\u0dc3\u0dd2\u0dbd\u0dd2\u0db8\u0dad\u0dca\u0dc0\u0db1 \u0d9c\u0dbd\u0dc3 \u0da2\u0db1\u0dad\u0dcf\u0dc0\u0d9c\u0dd9\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf\n\n\u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0d9c\u0dda. \u2022 \u0dc4\u0daf\u0dd2\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0daf\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0d9c\u0dda\u0dc1\u0dd3\u0dba \u0d86\u0db4\u0dd9\u0dcf \u0d9a\u0dc5\u0db8\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0db8\u0db0\u0dca\u200d\u0dba\u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0db1\u0dd2\u0dbd\u0db0\u0dca\u200d\u0dcf\u0dbb\u0dd3\u0db1\u0dca \u0d9c\u0dda \u0dc3\u0dc4\u0dba \u0db4\u0dad\u0db1\u0dca\u0db1. \u2022 \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0dd9\u0dba\u0dcf \u0d9c\u0dd9\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0db8\u0d9c\u0dd2\u0db1\u0dca \u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0dc0 \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db1\u0dd2\u0d9c\u0dda\u0dd9\u0db1 \u0db4\u0dd2\u0dbd\u0dd2\u0db6\u0db3\n\n\u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0db1\u0dba \u0d9c\u0dba\u0dcf\u0db8\u0dd4\u0d9a\u0dbb\u0db1 \u0d9c\u0dbd\u0dc3 \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0d9c\u0dda.\n\n\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dc3\u0dd9\u0dc4\u0dcf:\n\n\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dc3\u0dd9\u0dc4\u0dcf \u0d85\u0db1\u0dd4\u0dd9\u0db8\u0db1\u0dba \u0d9a\u0dbd \u0dba\u0dd4\u0dad\u0dd4 \u0d9a\u0dca\u200d\u0dbb\u0dd2\u0dba\u0dcf\u0db8\u0dcf\u0dbb\u0dca\u0dd9:\n\n\u2022 \u0dd9\u0dcf\u0dbd\u0dca\u0dbd \u0dc3\u0dd2\u0da7 \u0d9c\u0d9a\u0dcf\u0dc5\u0db9, \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0db8, \u0db8\u0db1\u0dca\u0db1\u0dcf\u0dbb\u0db8, \u0d9a\u0db1\u0dca\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0d9c\u0dbb\u0dca, \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0dcf"
