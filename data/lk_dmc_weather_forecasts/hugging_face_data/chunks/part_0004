0dcf\u0dbb\u0dca\u0d9c\u0dba. \u0db8\u0dd4\u0dbd\u0dcf\u0dc1\u0dca\u200d\u0dbb\u0dba: RSMC\n\nPage 2 of 5\n\n\u0d9a\u0d9c\u0ddc\u0da9\u0db6\u0dd2\u0db8 \u0db4\u0dca\u200d\u0dbb\u0d9a\u0dda\u0dc1\u0dba \u0dc3\u0daf\u0dc4\u0ddc : \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0daf\u0dd2\u0db1 \u0dad\u0dd4\u0db1 \u0dc3\u0db3\u0dc4\u0ddc \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0dd9\u0d82 \u0db4\u0dd2\u0dc5\u0dd2 \u0daf \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d87\u0d9f\u0dc0\u0dd3\u0db8.\n\n\u0db4\u0dc5\u0ddc\u0dad \u0da2\u0db1\u0dc0\u0ddc\u0dbb\u0dd2 08 \u0da2\u0db1\u0dc0\u0ddc\u0dbb\u0dd2 09 \u0da2\u0db1\u0dc0\u0ddc\u0dbb\u0dd2 10\n\n\u0d8b\u0dad\u0dd4\u0dbb \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(50-60) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(60-70) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d89\u0dad\u0dcf \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(60-70) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0d89\u0dad\u0dcf \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0d8b\u0dad\u0dd4\u0dbb\u0dd4-\u0db8\u0dd0\u0daf\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(50-60) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(50-60) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd2.(50-60) \u0dd9\u0db8\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0db1 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0d82\n\n\u0db1\u0dd0\u0d9a\u0d9c