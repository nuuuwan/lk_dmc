dbb\u0dba \u0dc3\u0dd2\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0dcf \u0db8\u0db4\u0dcf\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db8\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db8\u0db6\u0db1\u0dca\u0dad\u0dc0\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1 \u0dc3\u0db3\u0dc4\u0dcf.\n\n\u0db8\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0db8\u0db6\u0dcf\u0d9a\u0dca\u0db8\u0d9a\u0dca \u0daf\u0d9a\u0dd4\u0dab\u0dd4 \u0dc3\u0dc4 \u0d8a\u0da7 \u0dba\u0dcf\u0db6\u0daf \u0db6\u0da7\u0dc4\u0dd2\u0dbb-\u0db8\u0db0\u0dca\u200d\u0dba\u0db8 \u0db8\u0db6\u0d82\u0d9c\u0dcf\u0dbd \u0db8\u0db6\u0dcf\u0d9a\u0dca\u0d9a \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd2 \u201c\u0d85\u0d9a\u0dca\u0dc0\u0dcf\u0db1\u0dca\u0dad\u201d (Akvan) \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0, \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc0\u0dbb\u0dca\u0db0\u0dca\u200d\u0db1\u0dba \u0dc0\u0dd3 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0d9a\u0dca \u0db6\u0dc0\u0da7 \u0db4\u0dad\u0dca\u0dc0 \u0d87\u0dad. \u0d85\u0daf \u0daf\u0dd2\u0db1 (2026 \u0db8\u0db1\u0dcf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca 18 \u0dc0\u0db1) \u0d8b\u0daf\u0dd1\u0dc3\u0db1 05.30 \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0dc0\u0dd2\u0da7, \u0d91\u0dba \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d82\u0dc1 12.7\u00b0 \u0dc3\u0dc4 \u0db1\u0dd0\u0db8\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dda\u0dc1\u0dcf\u0d82\u0dc1 85.5\u00b0 \u0d86\u0dc3\u0db1\u0dca\u0dad\u0db1\u0db8\u0dda (\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0db8\u0dda \u0dc3\u0dd2\u0da7 \u0daf\u0dc5 \u0dc0\u0dc1\u0db8\u0dba\u0db1\u0dca\u0dad \u0d9a\u0dd2\u0db8\u0dbd\u0ddd\u0db8\u0dd3\u0da7\u0dbb\u0dca 650\u0d9a\u0dca \u0db4\u0db8\u0dab \u0daf\u0dd4\u0dbb\u0dd2\u0db1\u0dca\u0dad) \u0db8\u0d9a\u0dca\u0db1\u0dca\u0dad\u0dbb\u0d9c\u0dad\u0dc0 \u0db4\u0dd0\u0dc0\u0dad\u0dd4\u0dab\u0dd2. \u0db8\u0db8\u0db8 \u0db4\u0dda\u0db0\u0dca\u200d\u0dad\u0dd2\u0dba \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0d8b\u0dad\u0dd4\u0dbb\u0da7 \u0db6\u0dbb\u0dc0 \u0dc0\u0dba\u0db9 \u0db8\u0daf\u0dc3\u0da7 \u0d9c\u0db8\u0db1\u0dca\u0dad \u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca\u0dad, \u0db8\u0db8\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db6\u0dbd \u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0 2026 \u0db8\u0db1\u0dcf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca 20 \u0dc0\u0db1 \u0daf\u0dd2\u0db1 \u0d8b\u0daf\u0dd1\u0dc3\u0db1 11.30 \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0dc0\u0dd2\u0da7, \u0d89\u0db1\u0dca\u0dad\u0daf\u0dd2\u0dba\u0dcf\u0db8\u0dda \u0d86\u0db1\u0dca\u0dad\u0dbb \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dca \u0db8\u0dc0\u0dbb\u0dc5 \u0dad\u0dd3\u0dbb\u0db8\u0dda \u0db8\u0db1\u0db8\u0dbd\u0ddd\u0dbb\u0dca (Nellore) \u0dc3\u0dc4 \u0dc0\u0dd2\u0dc1\u0dcf\u0d9a\u0dcf\u0db4\u0da7\u0dca\u0db1\u0dda (Visakhapatnam) \u0d85\u0dad\u0dbb\u0dd2\u0db1\u0dca\u0dad \u0db8\u0d9c\u0dcf\u0da9\u0db6\u0dd2\u0db8\u0da7 \u0d87\u0dad\u0dd4\u0dc5\u0dd4 \u0dc0\u0db1\u0dd4 \u0d87\u0dad\u0dd0\u0dba\u0dd2 \u0d85\u0db8\u0dda\u0d9a\u0dca\u0dca\u0dcf \u0db8\u0d9a\u0db8\u0dbb\u0dca.\n\n\u0d91\u0db8\u0db1\u0dd2\u0dc3\u0dcf, \u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d82\u0dc1 06\u0dad\u0dca 20\u0dad\u0dca \u0dc3\u0dc4 \u0db1\u0dd0\u0db8\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dda\u0dc1\u0dcf\u0d82\u0dc1 80\u0dad\u0dca 95\u0dad\u0dca \u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dc4 \u0d9a\u0db1\u0dca\u0dad\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dbb\u0dba \u0dc3\u0dd2\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0da9\u0d9a\u0dbd\u0db4\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0dcf \u0db8\u0db4\u0dcf\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db8\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db8\u0db6\u0db1\u0dca\u0dad \u0dc0\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dc0\u0dbd\u0dad\u0dca \u0db1\u0dd0\u0dc0\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0db8\u0daf\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0dbd\u0d9a\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db8\u0dbd\u0dc3 \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0db8\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0db6\u0dca. \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dc0\u0dbd \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dbd \u0db8\u0dba\u0db8\u0daf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0db1\u0dca\u0dad \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1 \u0d9a\u0dbb\u0dcf \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0d9a\u0dbb\u0db1 \u0db8\u0dbd\u0dc3\u0dad\u0dca \u0d8b\u0db4\u0db8\u0daf\u0dc3\u0dca \u0db8\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0db6\u0dca.\n\n\u0db8\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0db0\u0db8\u0dd9\u0db1\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf \u0db8\u0daf\u0dca\u200d\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0db8\u0dda\u0db1\u0dca\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0d85\u0db1\u0dcf\u0dc0\u0dd0\u0d9a\u0dd2 \u0dc3\u0dc4 \u0db1\u0dd2\u0db8\u0dda\u0daf\u0dca\u200d\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0 \u0d85\u0dc0\u0db0\u0dcf\u0db1\u0db8\u0dd9\u0db1\u0dca \u0db4\u0dc3\u0dd4\u0dc0\u0db1 \u0db8\u0dbd\u0dc3 \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd4\u0d9a \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0db8\u0dd9\u0db1\u0dca \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0dda.\n\nwww.meteo.gov.lk\n\nhttps://was.meteo.gov.lk\n\n\u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf\u0da5: S. Jayasekara\n\n0112686686\n\n\u0db4\u0dd4\u0db8\u0dbb\u0ddd\u0d9a\u0dae\u0db1\u0dba \u0d9a\u0dbb\u0db1 \u0dbd\u0daf \u0dc3\u0dca\u0dae\u0dcf\u0db1 \u0dc3\u0dc4 \u0dad\u0dd3\u0dc0\u0dca\u200d\u0dbb\u0dad\u0dcf:\n\n\u0daf\u0dd2\u0db1\u0dba \u0db8\u0dda\u0dbd\u0dcf\u0dc0 \u0dc3\u0dca\u0dae\u0dcf\u0db1\u0dba(\u0d8b\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d82\u0dc1 /\u0db1\u0dd0\u0db8\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0db8\u0dda\u0dc1\u0dcf\u0d82\u0dc1)\n\n\u0d9a\u0dd0\u0dc5\u0db9\u0dd2\u0dbd\u0dd2 \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba"
