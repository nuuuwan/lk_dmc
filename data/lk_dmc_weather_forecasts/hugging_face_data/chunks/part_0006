9 \u0d87\u0dad. \u0dad\u0dc0\u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0d9c\u0db8\u0db8 \u0db4\u0dda\u0db0\u0dad\u0dd2\u0dba \u0d8b\u0dad\u0dd4\u0dbb\u0da7 \u0dbb\u0dc0 \u0dc0\u0dba\u0db9 \u0d9c\u0daf\u0dca\u200d\u0dc3\u0da7 \u0dd9\u0db8\u0db1\u0dca\n\n\u0d9a\u0dbb\u0db8\u0dd2\u0db1\u0dca, \u0d9c\u0db1\u0dcf\u0dc0\u0dd0\u0db8\u0dca \u0dbb\u0dca \u0db8\u0dc3 16 \u0dc0\u0dd0\u0db1\u0dd2\u0daf\u0dca\u200d\u0dcf \u0db4\u0db8\u0dab \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0daf\u0dca\u200d\u0d9a\u0dd4\u0dab\u0dd4 \u0dc3\u0dd9 \u0dba\u0dcf \u0daf\u0dca\u200d \u0da7\u0dc4\u0dd2\u0dbb \u0db8\u0db0\u0dba\u0db8 \u0d9c \u0d82\u0dd9\u0dcf\u0dbd \u0d9c \u0dcf\u0d9a\u0dca\u0d9a \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dba \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad\u0dc0\n\n\u0dc3\u0dd4\u0dc5\u0dd2 \u0d9a\u0dd4\u0dab\u0dcf\u0da7\u0dd4\u0dc0\u0d9a\u0dca \u0dc0\u0da7 \u0dc0\u0dbb\u0dca\u0db0\u0db1\u0dba \u0dc0\u0dd3\u0db8\u0da7 \u0dd9\u0dd0\u0d9a\u0dd2\u0dba\u0dcf\u0dc0 \u0db4\u0dc0\u0dad\u0dd3.\n\n\u0d91\u0db8\u0db1\u0dd2\u0dc3\u0dcf, 2026 \u0daf\u0db1\u0dcf\u0dc0\u0dd0\u0dda\u0db6\u0dbb\u0dca 14 \u0daf\u0dd2\u0db1 \u0d8b\u0daf\u0dd1\u0dc3\u0db1 05.30 \u0dc3\u0dd2\u0da7, \u0d8b\u0dd4\u0dbb\u0dd4 \u0d85\u0d9a\u0dca\u0dca\u0dcf\u0d82\u0dc1 05\u0dad\u0dca 15\u0dad\u0dca \u0dc3\u0dc4 \u0db1\u0dd0\u0daf\u0d9c\u0db1\u0dc4\u0dd2\u0dbb \u0daf\u0dda\u0dc1\u0dcf\u0d82\u0dc1 80\u0dad\u0dca 90\u0dad\u0dca\n\n\u0d85\u0dad\u0dbb \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0daf\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dc4 \u0d9a\u0db1\u0dca\u0dad\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0dbb\u0dba \u0dc3\u0dd2\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0daf\u0db4\u0dcf\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0dc4\u0dbb\u0dc4\u0dcf \u0dc4\u0dda\u0db6\u0db1\u0dca\u0dad\u0daf\u0dad\u0dcf\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0daf\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0daf\u0db6\u0db1\u0dca\u0dad\n\n\u0dc0\u0db1 \u0