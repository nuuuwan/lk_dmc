\u0dc0\u0dbd \u0dc3\u0dc4 \u0d9a\u0db1\u0dca\u0dad\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dbb\u0dba \u0dc3\u0dd2\u0da7\n\n\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0db4\u0dcf\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0dc4\u0dbb\u0dc4\u0dcf \u0dc4\u0dda\u0db6\u0db1\u0dca\u0dad\u0db8\u0dad\u0dcf\u0da7 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0db8\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db8\u0db6\u0db1\u0dca\u0dad \u0dc0\u0db1 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dc0\u0dbd\u0dad\u0dca \u0db1\u0dd0\u0dc0\u0dad \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0db8\u0daf\u0db1\u0dad\u0dd4\u0dbb\u0dd4\n\n\u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd4\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4\u0dc0\u0dbd\u0dd2\u0db1\u0dca\u0dad \u0dc0\u0dd0\u0dbd\u0d9a\u0dd3 \u0dc3\u0dd2\u0da7\u0dd2\u0db1 \u0db8\u0dbd\u0dc3 \u0daf\u0dd0\u0db1\u0dd4\u0dda \u0db8\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0db6\u0dca. \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1\u0dc0\u0dbd \u0db0\u0dd3\u0dc0\u0dbb \u0dc3\u0dc4 \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0d9a\u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dbd\n\n\u0db8\u0dba\u0db8\u0daf\u0db1 \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0db1\u0dca\u0dad \u0d86\u0dbb\u0d9a\u0dca\u200d\u0dc2\u0dd2\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0dda\u0dc1 \u0d9a\u0dbb\u0dcf \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0d9a\u0dbb\u0db1 \u0db8\u0dbd\u0dc3\u0dad\u0dca \u0d8b\u0db4\u0db8\u0daf\u0dc3\u0dca \u0db8\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0db6\u0dca.\n\n\u0d9c\u0db8\u0dca \u0dc3\u0db8\u0dca \u0db1\u0dca\u0db0\u0d9c\u0dba\u0db1\u0dca \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0daf\u0dca\u200d\u0dba\u0dcf \u0d9c\u0daf\u0dca\u200d\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0d9c\u0db8\u0dca\u0db1\u0dca\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd \u0db1 \u0d89\u