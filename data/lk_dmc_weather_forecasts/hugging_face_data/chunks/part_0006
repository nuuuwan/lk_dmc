0dc0\u0dd0\u0dc3\u0dd2 \u0db1\u0dc4\u0ddc\u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2. \u0dc3\u0dd4\u0dc5\u0dcf\u0d82 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba:\n\n05N-15N, 83E-100E : \u0dd0\u0db1\u0dd9 \u0dc4\u0dd2\u0dbb \u0dc3\u0dd2\u0da7 \u0d9c\u0dd2\u0db1\u0dd2\u0db1\u0d9a\u0ddc\u0dab \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0dc0\u0dd6 \u0daf\u0dd2\u0dc1\u0ddc\u0dc0\u0dbd\u0dd2\u0db1\u0dca / \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (30-40); \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. 50 \u0daf\u0d9a\u0dca\u0dc0\u0ddc. EQ-05N, 90E-100E : \u0d9c\u0dd2\u0db1\u0dd2\u0db1\u0d9a\u0ddc\u0dab \u0db1\u0daf\u0dc3\u0dd2\u0db1\u0dca/\u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (20-30). \u0db1\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1 : \u0d8a\u0dc3\u0ddc \u0db1\u0daf\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dc4\u0ddc\u0ddd \u0db1\u0dd2\u0dc1\u0ddd\u0dd2\u0dad \u0daf\u0dd2\u0dc1\u0ddc\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dad\u0ddc\u0dbb\u0dc0 /\u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (20-30). \u0db8\u0dd4\u0dc4\u0dd4\u0d9c\u0dda \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba:\n\n05N-15N, 83E-100E : \u0db8\u0db3 \u0dc0\u0dc1\u0db1\u0dba\u0db1\u0dca \u0dbb\u0dc5\u0dd4, \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dad\u0dbb\u0db8\u0d9a\u0dca \u0dbb\u0dc5\u0dd4. \u0db1\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1 : \u0dc3\u0ddc\u0db8\u0ddc \u0dba \u0dc3\u0ddd\u0dc0\u0db7\u0ddc\u0dc0\u0db1\u0dda \u0dc3\u0dd2\u0da7, \u0db8\u0db3 \u0dc0\u0dc1\u0db1\u0dba\u0db1\u0dca \u0dbb\u0dc5\u0dd4 \u0daf\u0d9a\u0dca\u0dc0\u0ddc. \u0d85\u0dbb\u0dcf\u0db6\u0dd2 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\n\n\u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab\u0dd2\u0d9a \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba:\n\nEQ -08N, 70E-80E : \u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0dad\u0dd0 \u0dc0\u0dd0\u0dc3\u0dd2 \u0db1\u0dc4\u0ddc\u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2. EQ -18N, 60E-70E : \u0dc3\u0ddd\u0dae\u0ddc \u0dc3\u0ddd\u0dc0\u0dbd\u0dca\u0dd9\u0dba\u0d9a \u0dc0\u0dd0\u0dc3\u0dd2 \u0db1\u0dc4\u0ddc\u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2. \u0db1\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1 : \u0dc0\u0dd0\u0dc3\u0dd2 \u0dbb\u0dc4\u0dd2\u0dad.\n\n\u0dc0\u0dd0\u0dc3\u0dd2 \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba: \u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dc0\u0dca \u0dc3\u0dd2\u0da7 \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0ddc\u0db8\u0dbd\u0dba \u0dc3\u0dc4 \u0db8\u0da9\u0d9a\u0dc5\u0db4\u0dd4\u0dc0 \u0dc4\u0dbb\u0dc4\u0ddc \u0db1\u0dd9\u0ddc\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0db1\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db6\u0dd9\u0db1\u0db6\u0db1\u0dca\u0dc0 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dc0\u0dbd \u0dc0\u0dd0\u0dc3\u0dd2 \u0dc3\u0ddd\u0dc0\u0dbd\u0dca\u0dd9\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a. \u0db8\u0dd3\u0dd9\u0db8\u0dd4\u0dc0 \u0dc3\u0dd2\u0da7 \u0db1\u0d9a\u0ddc\u0dc5\u0db9 \u0dc3\u0dc4 \u0dd9\u0ddc\u0dbd\u0dca\u0dbd \u0dc4\u0dbb\u0dc4\u0ddc \u0db8\u0ddc\u0dad\u0dbb \u0daf\u0d9a\u0dca\u0dc0\u0ddc \u0db1\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0db6\u0dd9\u0db1\u0db6\u0db1\u0dca \u0dc0 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dc0\u0dbd \u0dc4\u0dc0\u0dc3\u0ddd \u0d9a\u0ddc\u0dbd\u0db1\u0dda\u0daf\u0dd3 \u0db1\u0dc4\u0ddc\u0ddd \u0dbb\u0ddc\u0dad\u0dca\u200d\u0dbb\u0dd3 \u0d9a\u0ddc\u0dbd\u0db1\u0dda\u0daf\u0dd3 \u0dad\u0dd0\u0db1\u0dd2\u0db1\u0dca \u0dad\u0dd0 \u0dc0\u0dd0\u0dc3\u0dd2 \u0db1\u0dc4\u0ddc\u0ddd \u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a. \u0daf\u0dd2\u0dc0\u0dba\u0dd2 \u0dc0\u0da7\u0ddc \u0dc0 \u0db1\u0dc3\u0dc3\u0dd4 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dc0\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db0\u0ddc \u0dc0\u0dc1\u0db1\u0dba\u0db1\u0dca \u0dc0\u0dd0\u0dc3\u0dd2 \u0dbb\u0dc4\u0dd2\u0dad \u0d9a\u0ddc\u0dbd\u0d9c\u0dd4\u0dab\u0dba\u0d9a\u0dca \u0dd9\u0dc0\u0dad\u0dd3. \u0dc3\u0dd4\u0dc5\u0d9f: \u0daf\u0dd2\u0dc0\u0dba\u0dd2 \u0dc0\u0da7\u0ddc \u0dc0 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dd4\u0dc5\u0d82 \u0d8a\u0dc3\u0ddc \u0db1\u0daf\u0dc3\u0dd2\u0db1\u0dca \u0db1\u0dc4\u0ddc\u0ddd \u0db1\u0dd2\u0dc1\u0ddd\u0dd2\u0dad \u0daf\u0dd2\u0dc1\u0ddc\u0dc0\u0d9a\u0dd2\u0db1\u0dca \u0db1\u0dad\u0ddc\u0dbb\u0dc0 \u0dc4\u0db8 \u0d85\u0dad\u0dbb \u0dc3\u0dd4\u0dc5\u0db1\u0dda \u0db1\u0dc0\u0dca\u0dd9\u0dba \u0dd9\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (20-30) \u0dd9\u0db8\u0dab \u0db1\u0dc0\u0dca. \u0db8\u0dd4\u0dc4\u0dd4\u0d9c\u0dda \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba:\n\n\u0daf\u0dd2\u0dc0\u0dba\u0dd2 \u0dc0\u0da7\u0ddc \u0dc0 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0db1\u0dda\u0dc1 \u0db8\u0daf \u0dc0\u0dc1\u0db1\u0dba\u0db1\u0dca \u0dbb\u0dc5\u0dd4 \u0db1\u0dc0\u0dca.\n\n\u0d9c\u0dd2\u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0dca \u0dc3\u0dc4\u0dd2\u0dad \u0dc0\u0dd0\u0dc3\u0dd2 \u0d87\u0dad\u0dd2 \u0dc0\u0db1 \u0dc0\u0dd2\u0da7 \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1\u0dc0\u0dbd \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a\u0dc0 \u0dad\u0daf \u0dc3\u0dd4\u0dc5\u0dcf\u0d82 \u0d87\u0dad\u0dd2 \u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2 \u0d85\u0dad\u0dbb \u0d91\u0dc0\u0dd2\u0da7 \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0d9c\u0dda\u0dc1 \u0dad\u0dcf\u0dc0\u0d9a\u0dcf\u0dbd\u0dd2\u0d9a\u0dc0 \u0d89\u0dad\u0dcf \u0dbb\u0dc5\u0dd4 \u0dc0\u0dd2\u0dba \u0dc4\u0d