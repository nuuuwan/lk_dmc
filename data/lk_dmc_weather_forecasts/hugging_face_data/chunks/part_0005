u0dad \u0daf\u0dd0\u0db1\u0dd4\u0dda\u0daf\u0daf\u0db1 \u0dad\u0dd4\u0dbb\u0dd4 \u0dba\u0dcf\u0dad\u0dca\u200d\u0dbb\u0dcf \u0daf\u0db1\u0dcf\u0d9a\u0dbb\u0db1 \u0daf\u0dbd\u0dc3 \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0dc3\u0dc4 \u0db0\u0dd3\u0dc0\u0dbb \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0db1\u0dca\u0dad\u0da7 \u0daf\u0dd0\u0db1\u0dd4\u0dda\u0daf\u0daf\u0db1\u0dd4 \u0dbd\u0dd0\u0daf\u0db6\u0dca. \u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dd4\u0dab\u0dcf\u0db8\u0dbd\u0dd9 \u0dc3\u0dd2\u0da7 \u0db8\u0dd4\u0dbd\u0dad\u0dd2\u0dda \u0dc4\u0dbb\u0dc4\u0dcf \u0d9a\u0db1\u0dca\u0d9a\u0dc3\u0db1\u0dca\u0dad\u0dd4\u0dbb\u0dd9 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc3\u0dc4 \u0d9a\u0dbd\u0dca\u0db4\u0dd2\u0da7\u0dd2\u0dd9 \u0dc3\u0dd2\u0da7 \u0dba\u0d9a\u0dcf\u0dc5\u0db9, \u0d9c\u0dcf\u0dbd\u0dca\u0db4\u0dbd \u0dc3\u0dc4 \u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dba\u0dad\u0dcf\u0da7 \u0dc4\u0dbb\u0dc4\u0dcf \u0dba\u0db4\u0dcf\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca\u0db4 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dba\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0dba\u0db6\u0db1\u0dca \u0dc0\u0db1\u0dca\u200d \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dc1\u0dc0\u0dbd \u0dc3\u0dd4\u0dc5\u0dba\u0dda \u0dba\u0dda\u0d9c\u0dd9 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3. (50-60) \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dc0\u0dd0\u0da9\u0dd2 \u0dc0\u0db1\u0dca\u200d \u0d85\u0dad\u0dbb \u0d91\u0db8 \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dc1 \u0dc0\u0dd2\u0da7\u0dd2\u0db1\u0dca \u0dc0\u0dd2\u0da7 \u0dbb\u0dc5\u0dd4 \u0dba\u0dda. \u0db8\u0db1\u0dca\u0db1\u0dca\u200d\u0dcf\u0dbb\u0db8 \u0dc3\u0dd2\u0da7 \u0dba\u0d9a\u0dcf\u0dc5\u0db9, \u0d9c\u0dcf\u0dbd\u0dca\u0db4\u0dbd \u0dc3\u0dc4 \u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0dba\u0dad\u0dcf\u0da7 \u0dc4\u0dbb\u0dc4\u0dcf \u0dba\u0db4\u0dcf\u0dad\u0dd4\u0dc0\u0dd2\u0dbd\u0dca\u0db4 \u0daf\u0d9a\u0dca\u0dc0\u0dcf \u0dba\u0dc0\u0dbb\u0dc5\u0da7 \u0d94\u0db6\u0dca\u0dba\u0db6\u0db1\u0dca \u0dc0\u0db1\u0dca\u200d \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0db4\u0dca\u200d\u0dbb\u0dba\u0dda\u0dc1\u0dc0\u0dbd \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0dbb\u0dc5 \u0d8b\u0dc3 \u0db8\u0dd3\u0da7\u0dbb\u0dca (2.0 \u2013 2.5) \u0d9a\u0dca \u0db4\u0db8\u0dab \u0d89\u0dc4\u0dc5 \u0dd9\u0dcf\u0dba\u0db8\u0dca \u0dc4\u0dd0\u0d9a\u0dd2\u0dd9\u0dcf\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd3. \u0d9a\u0dcf\u0dbd\u0d9c\u0dd4\u0dab \u0dc0\u0dd2\u0daf\u0dba\u0dcf \u0daf\u0daf\u0db4\u0dcf\u0dbb\u0dca\u0dad\u0daf\u0dda\u0db1\u0dca\u0dad\u0dad\u0dd4\u0dc0 \u0dc0\u0dd2\u0dc3\u0dd2\u0db1\u0dca\u0dad \u0daf\u0dda \u0dc3\u0dda\u0db6\u0db1\u0dca\u0dad\u0db0\u0dca\u200d\u0daf\u0dba\u0db1\u0dca\u0dad \u0db1\u0dd2\u0d9a\u0dd4\u0dad\u0dca \u0d9a\u0dbb\u0db1\u0dd4 \u0dbd\u0db6\u0db1 \u0d89\u0daf\u0dd2\u0dbb\u0dd2 \u0db1\u0dd2\u0daf\u0dda\u0daf\u0db1 \u0db4\u0dd2\u0dc5\u0dd2\u0db6\u0db3\u0dc0, \u0d85\u0dc0\u0db0\u0dca\u200d\u0dcf\u0db1\u0daf\u0dba\u0db1\u0dca\u0dad \u0db4\u0dc3\u0dd4 \u0dc0\u0db1 \u0daf\u0dbd\u0dc3 \u0db0\u0dd3\u0dc0\u0dbb \u0dc4\u0dcf \u0db1\u0dcf\u0dc0\u0dd2\u0d9a \u0db4\u0dca\u200d\u0dbb\u0da2\u0dcf\u0dc0\u0daf\u0d9c\u0db1\u0dca\u0dad \u0d89\u0dbd\u0dca\u0db4\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0daf\u0db6\u0dca.\n\n\u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dda \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba : \u0db1\u0dd2\u0dc3\u0dbd (0-5)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3 ,\u0dc3\u0dd4\u0db8\u0da7 (5-15)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3, \u0dc3\u0dcf\u0db8\u0dcf\u0db1\u0dca\u200d\u0dba \u0dc3\u0dca\u0dc0\u0db7\u0dcf\u0dc0\u0dba\u0dd9\u0db1\u0dca \u0dba\u0dd4\u0dad\u0dd4 (16-28)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3, \u0db8\u0daf\n\n\u0dbb\u0dc5\u0dd4 (29-37)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3, \u0dad\u0dbb\u0db8\u0d9a\u0dca \u0dbb\u0dc5\u0dd4 (38-46)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3, \u0dbb\u0dc5\u0dd4 (47-55)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3, \u0d89\u0dad\u0dcf \u0dbb\u0dc5\u0dd4 (56-74)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3, \u0daf\u0dc5 \u0dbb\u0dc5\u0dd4 (75-\n\n102)\u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3, \u0d89\u0dad\u0dcf \u0daf\u0dc5 \u0dbb\u0dc5\u0dd4 103 \u0db4\u0dd0.\u0d9a\u0dd2.\u0db8\u0dd3 \u0da7 \u0dc0\u0dd0\u0da9\u0dd2.\n\nBulletin No: 11 MWW/2026/06/12/01 COLOR: Red"
