    ],
    "text": "\u0daf\u0dd0\u0daf\u0dd4\u0dbb\u0dd4 \u0d94\u0dba \u0db4\u0dbb\u0ddd\u0dab\u0dd2\u0db4\u0dda \u0d89\u0dc4\u0dc5 \u0dc4\u0dcf \u0db8\u0db0\u0dca\u200d\u0dba \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1\u0dc0\u0dbd\u0da7 \u0d87\u0daf\u0dc4\u0dd0\u0dbd\u0dd4\u0dab\u0dd4 \u0dc3\u0dd0\u0dbd\u0d9a\u0dd2\u0dba \u0dba\u0dd4\u0dad\u0dd4 \u0dc0\u0dbb\u0dca\u0dc2\u0dcf \u0dad\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad\u0dc0\u0dba \u0db4\u0dc4\u0dda\u0dad\u0dd4\u0db4 \u0dcf\u0da7\u0db4\u0dd9\u0db1 \u0daf\u0dd0\u0daf\u0dd4\u0dbb\u0dd4 \u0d94\u0db4\u0dba\u0dc4\u0dd2 \u0da2\u0dbd \u0db8\u0da7\u0dca\u0da7\u0db8 \u0dd9\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0db8\u0da7\u0dca\u0da7\u0db8\u0da7 \u0d86\u0dc3\u0db1\u0dca\u0db1\u0dc0 \u0dd9\u0dc0\u0dad\u0dd3. \u0dad\u0dc0\u0daf \u0daf\u0dd0\u0daf\u0dd4\u0dbb\u0dd4 \u0d94\u0dba \u0da2\u0dbd\u0dcf\u0dc1\u0db8\u0dda \u0db4\u0dd2\u0da7\u0dc0\u0dcf\u0db1\u0dca \u0db4\u0daf\u0dcf\u0dbb\u0da7\u0dd4 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0dbb \u0db4\u0db8\u0dca \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0dad\u0dad\u0dca\u0db4\u0dbb\u0dba\u0da7 \u0d9d\u0dab \u0d85\u0da9\u0dd2 16500 \u0d9a\u0dca \u0dad\u0dbb\u0db8\u0dca \u0dc3\u0dd3\u0d9d\u0dca\u200d\u0dbb\u0dad\u0dcf\u0dc0\u0dba\u0d9a\u0dd2\u0db1\u0dca \u0daf\u0dd0\u0daf\u0dd4\u0dbb\u0dd4 \u0d94\u0dba\u0da7 \u0da2\u0dbd\u0dba \u0db8\u0dd4\u0daf\u0dcf\u0dc4\u0dbb\u0dd2\u0db8\u0dd2\u0db1\u0dca \u0dd9\u0dc0\u0dad\u0dd3. \u0db8\u0dda \u0dc0\u0db1\u0dc0\u0dd2\u0da7 \u0da2\u0dbd\u0dcf\u0dc1\u0dba\u0da7 \u0dbd\u0dd0\u0db8\u0dd9\u0db1 \u0da2\u0dbd \u0db0\u0dcf\u0dbb\u0dd2\u0dad\u0dcf\u0dc0 \u0d85\u0db1\u0dd4\u0dc0 \u0db8\u0dd9\u0dd9 \u0db4\u0dca\u200d\u0dbb\u0dd9\u0dcf\u0dab\u0dba \u0d89\u0daf\u0dd2\u0dbb\u0dd2\u0db8\u0dda\u0daf\u0dd3 \u0dad\u0dc0 \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0dc0\u0dd0\u0da9\u0dd2 \u0d9a\u0dd2\u0dbb\u0dd3\u0dd9\u0da7 \u0dc3\u0dd2\u0daf\u0dd4\u0dc0\u0dd2\u0dba \u0dc4\u0dd0\u0d9a\u0dd2\u0dba. \u0db4\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad\u0dc0\u0dba \u0db8\u0dad \u0daf\u0dd0\u0daf\u0dd4\u0dbb\u0dd4 \u0d94\u0dba \u0db4\u0dbb\u0ddd\u0dab\u0dd2\u0db4\u0dda \u0db4\u0dd2\u0dc4\u0dd2\u0da7\u0dd2 \u0dc0\u0dcf\u0dbb\u0dd2\u0dba\u0db8\u0db4\u0dcf\u0dbd, \u0db1\u0dd2\u0d9a\u0dc0\u0dd0\u0dbb\u0da7\u0dd2\u0dba, \u0dd9\u0dc4\u0dc0, \u0db8\u0d9a\u0dcf\u0db8\u0dd9\u0dba\u0dd2\u0d9c\u0db8\u0dda, \u0db6\u0d82\u0d9c\u0dd2\u0dbb\u0dd2\u0dba, \u0db4\u0dbd\u0dca\u0dbd\u0dd9, \u0dc4\u0dbd\u0dcf\u0dc0\u0dad, \u0d86\u0dbb\u0da0\u0dca\u0da0\u0dd2\u0d9a\u0da7\u0dca\u0da7\u0dd4\u0dc0 \u0dc3\u0dc4 \u0dbb\u0dc3\u0dca\u0db1\u0dcf\u0dba\u0d9a\u0db4\u0dd4\u0dbb \u0dba\u0db1 \u0db4\u0dca\u200d\u0dbb\u0dcf\u0db4\u0dda\u0dc1\u0dd3\u0dba \u0db4\u0dda \u0db8\u0dca \u0db4 \u0dcf\u0da7\u0dca\u0da8\u0dcf\u0dc1 \u0dc0\u0dbd\u0da7 \u0d85\u0dba\u0dad\u0dca\u0dad \u0dd9\u0d82\u0d9f\u0dcf \u0db1\u0dd2\u0db8\u0dca\u0db1\u0db4\u0dda \u0dd9\u0dc4\u0dc5 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1\u0dc0\u0dbd\u0da7 \u0dc4\u0dcf \u0d92 \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad \u0dd9\u0dc4\u0dad\u0dca\u0dad\u0dd2\u0db8\u0dca \u0dc0\u0dbd\u0da7 \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba\u0d9a\u0dca \u0d87\u0dad\u0dd2\u0dc0\u0dd2\u0db4\u0db8\u0dca \u0d85\u0dc0\u0daf\u0dcf\u0db1\u0db8\u0d9a\u0dca \u0d87\u0dad\u0dd2 \u0db6\u0dc0\u0da7 \u0d85\u0db1\u0dad\u0dd4\u0dbb\u0dd4 \u0d85\u0d9f\u0dc0\u0db1\u0dd4 \u0dbd\u0dd0\u0db4\u0dda. \u0db4\u0db8\u0dca \u0dad\u0dad\u0dca\u0dad\u0dad\u0dca\u0dad\u0dc0\u0dba \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0db4\u0dba\u0db1\u0dca \u0daf\u0dd0\u0da9\u0dd2 \u0dc3\u0dd0\u0dc5\u0d9a\u0dd2\u0dda\u0dbd\u0d9a\u0dd2\u0db1\u0dca \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dbb\u0db1 \u0db4\u0dbd\u0dc3 \u0d91\u0db8 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1\u0dc0\u0dbd \u0dd9\u0daf\u0dd2\u0d82\u0da0\u0dd2 \u0db8\u0dc4\u0da2\u0db1\u0dad\u0dcf\u0dc0\u0db4\u0dd9\u0db1\u0dca \u0dc3\u0dc4 \u0db4\u0dca\u200d\u0dbb\u0db4\u0dda\u0dc1 \u0db8\u0dcf\u0dbb\u0dca\u0dd9 \u0dc4\u0dbb\u0dc4\u0dcf \u0dd9\u0db8\u0db1\u0dca \u0dd9\u0db1\u0dca\u0db1\u0dcf \u0dc0\u0dcf\u0dc4\u0db1 \u0dd9\u0daf\u0dc0\u0db1\u0dca\u0db1\u0db1\u0dca\u0db4\u0dd9\u0db1\u0dca \u0d89\u0dda\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0db4\u0dda. \u0dad\u0dc0\u0daf \u0db4\u0db8\u0dca \u0dc3\u0db8\u0dca\u0db6\u0db1\u0dca\u0db0\u0dca\u200d\u0db4\u0dba\u0db1\u0dca \u0d85\u0dc0\u0dc1\u0dba \u0db4\u0dd2\u0dba\u0dc0\u0dbb \u0d9c\u0dda\u0db1\u0dcf \u0db8\u0dbd\u0dc3 \u0d86\u0db4\u0daf\u0dcf \u0d9a\u0dc5\u0dd9\u0db1\u0dcf\u0d9a\u0dbb\u0dab \u0d85\u0d82\u0dc1\u0dc0\u0dbd\u0dd2\u0dda \u0d89\u0dbd\u0dca\u0dbd\u0dcf \u0dc3\u0dd2\u0da7\u0dd2\u0db1\u0dd4 \u0dbd\u0dd0\u0db8\u0dda. \u0ba4\u0bc6\u0ba4\u0bc1\u0bb0\u0bc1 \u0b93\u0baf\u0bbe \u0b86\u0bb1\u0bcd\u0bb1\u0bc1\u0baa\u0bcd \u0baa\u0b9f\u0bc1\u0b95\u0bc8\u0baf\u0bbf\u0ba9\u0bcd \u0bae\u0bc7\u0bb2\u0bcd \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bc7\u0ba4\u0bcd\u0bc6\u0bbf\u0baf \u0baa\u0b95\u0bc1\u0bc6\u0bbf\u0bc8\u0bb3\u0bbf\u0bb2\u0bcd \u0ba4\u0baa\u0baf\u0bcd\u0bc6 \u0b95\u0bc1\u0bb1\u0bbf\u0baa\u0bcd\u0baa\u0bbf\u0b9f\u0ba4\u0bcd\u0bc6\u0b95\u0bcd\u0bc8",
