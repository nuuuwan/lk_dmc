    "text": "\u0b87\u0ba4\u0ba9\u0bcd \u0b95\u0bcb\u0bc8\u0ba3\u0bc7\u0bcb\u0b95 \u0bb0\u0bc1\u0bb5\u0ba9\u0bcd\u0bb5\u0bb5\u0bb2\u0bcd\u0bb2, \u0b9a\u0bc0\u0ba4\u0bcb\u0bb5\u0b95\u0bcd\u0b95, \u0bb5\u0ba4\u0bcb\u0bae\u0bcd\u0bae\u0baa, \u0bb5\u0ba4\u0bb9\u0bbf\u0bae\u0baf\u0bcb\u0bb5\u0bbf\u0bb1\u0bcd\u0bb1, \u0b8e\u0bb5\u0bb9\u0bb2\u0bbf\u0baf\u0bb5\u0b95\u0bcb\u0b9f, \u0baf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf\u0bcb\u0ba8\u0bcd\u0bae\u0ba4\u0bcb\u0b9f\u0bcd\u0b95\u0b9f \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0baa\u0bc1\u0bb2\u0ba4\u0bcd\u0bb5\u0b95\u0bcb\u0bb9\u0bc1\u0baa\u0bbf\u0b9f\u0bcd\u0b9f\u0bbf\u0baf \u0b86\u0b95\u0bbf\u0baf \u0baa\u0bbf\u0bc8\u0bae\u0ba4\u0b9a \u0bb5\u0b9a\u0baf\u0bb2\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bcb\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bcb\u0bb4\u0bcd\u0ba8\u0bbf\u0bb2\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bcd \u0baa\u0bcb\u0ba4\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bb2\u0bcb\u0bae\u0bcd \u0b8e\u0ba9 \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0baa\u0bcb\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0b95\u0bbf\u0bb1\u0ba4\u0bc1.",
