    "text": "\u0b87\u0ba8\u0bcd\u0ba4 \u0bc7\u0b95\u0bc8 \u0ba8\u0bbf\u0b95\u0bb2\u0b95\u0bc7 \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0baa\u0bcd\u0baa\u0bcb\u0bc6\u0ba9\u0ba4\u0bcd \u0ba4\u0bbf\u0b95\u0ba3\u0b95\u0bcd\u0b95\u0bb3\u0ba4\u0bcd\u0ba4\u0bbf\u0ba9\u0bcb\u0bb2\u0bcd \u0b95\u0bb3\u0ba9\u0bbf \u0b95\u0b99\u0bcd\u0b95\u0b95 \u0bb5\u0b9f\u0bbf\u0ba8\u0bbf\u0bb2\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0baa\u0bc7\u0bcb\u0bc7\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0baa\u0bcd\u0baa\u0b9f\u0bc1\u0bae\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0bc7\u0bcb\u0ba9\u0bbf\u0b95\u0bb3\u0bbf\u0ba9\u0bcd \u0ba8\u0bc0\u0bb0\u0bcd\u0bc7\u0b9f\u0bcd\u0b9f\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0baa\u0bcd\u0baa\u0bcb\u0baf\u0bcd\u0bb5\u0bc1\u0b95\u0bb3\u0bbf\u0ba9\u0bcd\u0baa\u0b9f\u0bbf, \u0b8e\u0ba4\u0bbf\u0bb0\u0bcd\u0bb5\u0bb0\u0bc1\u0bae\u0bcd 48 \u0bc7\u0ba3\u0bbf\u0ba4\u0bcd\u0ba4\u0bbf\u0baf\u0bcb\u0bb2\u0b99\u0bcd\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0bb3\u0bcd \u0b9a\u0ba4\u0bb9\u0bbf\u0bae\u0baf\u0bcb\u0bb5\u0bbf\u0bb1\u0bcd\u0bb1, \u0bb0\u0bc1\u0bb5\u0ba9\u0bcd\u0b9a\u0bb5\u0bb2\u0bcd\u0bb2 \u0bc7\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0bc6\u0bc0\u0ba4\u0bcb\u0bb5\u0b95\u0bcd\u0b95 \u0baa\u0bbf\u0bc7\u0bae\u0ba4\u0bc6 \u0b9a\u0bc6\u0baf\u0bb2\u0b95\u0baa\u0bcd \u0baa\u0bbf\u0bb0\u0bbf\u0bb5\u0bc1\u0b95\u0bb3\u0bc1\u0b95\u0bcd\u0b95\u0bc1\u0b9f\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b95\u0bb3\u0ba9\u0bbf \u0b95\u0b99\u0bcd\u0b95\u0b95 \u0baa\u0bb3\u0bcd\u0bb3\u0ba4\u0bcd\u0ba4\u0bcb\u0b95\u0bcd\u0b95\u0bbf\u0ba9\u0bcd \u0ba4\u0bcb\u0bb4\u0bcd\u0ba8\u0bbf\u0bb2\u0baa\u0bcd \u0baa\u0b95\u0bc1\u0ba4\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd \u0b95\u0ba3\u0bbf\u0bc6\u0bc7\u0bcb\u0ba9 \u0b85\u0bb3\u0bb5\u0bbf\u0bb2\u0bcb\u0ba9 \u0b9a\u0bb5\u0bb3\u0bcd\u0bb3\u0baa\u0bcd \u0b9a\u0baa\u0bb0\u0bc1\u0b95\u0bcd\u0b95\u0bc1 \u0b8f\u0bb1\u0bcd\u0baa\u0b9f\u0b95\u0bcd\u0b95\u0bc2\u0b9f\u0bc1\u0bae\u0bcd \u0b8e\u0ba9 \u0b8e\u0b9a\u0bcd\u0bc6\u0bb0\u0bbf\u0b95\u0bcd\u0b95\u0b95 \u0bb5\u0b