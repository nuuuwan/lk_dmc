    "chunk_text": "\u0d9c\u0dd0\u0db1\u0dd3\u0db8\u0db8\u0dca \u0d9c\u0dd0\u0da7\u0dc5\u0dd4\u0dc0\u0d9a\u0dca \u0db4\u0dc0\u0dad\u0dd2 \u0db6\u0dc0 \u0dc0\u0ddc\u0dbb\u0dca\u0dad\u0ddc \u0dc0\u0dd2\u0dba. \u0db8\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0db6\u0db3 \u0dd1\u0d9c\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d86\u0db4\u0daf\u0ddc \u0dc5\u0db8 \u0ddc \u0dbb\u0dab \u0d92 \u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dca\u0db6\u0db1\u0dca\u0dd3 \u0dbb\u0dab\u0dba \u0dbb \u0dbd\u0daf\u0dd2. 3. \u0db8\u0daf\u0dd2\u0d95\u0dc0\u0dd2\u0da7, \u0dad\u0dbd\u0dca\u0daf\u0dd6\u0dc0, \u0d9c\u0dd4\u0dbb\u0dd4\u0db8\u0d9c\u0ddc\u0dbd\u0dca\u0dbd \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dca\u0dc1\u0db8\u0dda \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0db8\u0dc4\u0dbb\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dca \u0db4\u0dd4\u0daf\u0dca\u0d9c\u0dbd\u0dba\u0dd2\u0db1\u0dca 50 \u0db8\u0daf\u0db8 \u0d9a\u0dd4 \u0db8 \u0ddc\u0da7\u0dd4\u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0db6\u0dc0 \u0dc0\u0ddc\u0dbb\u0dca\u0dad\u0ddc \u0dc0\u0dd2\u0dba. \u0db8\u0db8\u0dca \u0db4\u0dd2\u0dc5\u0db6\u0db3\n\n\u0dd1\u0d9c\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d86\u0db4\u0daf\u0ddc \u0dc5\u0db8 \u0ddc \u0dbb\u0dab \u0d92 \u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dca\u0db6\u0db1\u0dca\u0dd3 \u0dbb\u0dab\u0dba \u0dbb \u0dbd\u0daf\u0dd2. \u0d85\u0db1\u0dd4\u0dbb\u0dcf\u0db0\u0dca\u200d\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0d9a\u0dba\n\n1. \u0dc4\u0daf\u0dc3\u0dd2 \u0d9c\u0d82\u0dc0\u0dad\u0dd4\u0dbb \u0dad\u0dad\u0dca\u0dad\u0dca\u0dc0\u0dba \u0db8\u0dc4\u0dbb\u0dad\u0dd4\u0db8\u0dc0\u0db1\u0dca \u0db8\u0dd0\u0daf\u0dc0\u0da0\u0dca\u0da0\u0dd2\u0dba \u0db4\u0dca\u200d\u0dbb\u0ddc.\u0db8\u0dbd\u0dca.\u0db8 \u0ddc\u0da7\u0dca\u0da8\u0ddc\u0dc1\u0db8\u0dda \u0dc3\u0dca\u0dad\u0dca\u200d\u0d82\u0d9c\u0dbd\u0dd2 \u0daf\u0dbb\u0ddc\u0dc0 \u0dc4\u0ddc \u0daf\u0dd4\u0db8\u0dd2\u0db1\u0dca\u0db8\u0daf\u0dca\u0d9c\u0db8 \u0dba \u0d9c\u0db8\u0dca\u0db8\u0ddc \u0dc0\u0dbd\n\n1. \u0d9c\u0db1\u0dca\u0daf\u0dbb \u0dd3\u0dc0\u0dbb \u0dc0\u0dbb\u0ddc\u0db8\u0dba\u0db1\u0dca \u0db8\u0dd4\u0dc4\u0dd4\u0daf\u0dd4 \u0d9c\u0dba \u0db6\u0dc4\u0dd4\u0daf\u0dd2 \u0dd3\u0dc0\u0dbb \u0dba\u0ddc\u0dad\u0dca\u200d\u0dbb\u0ddc\u0dc0\u0d9a\u0dca \u0daf\u0dd0\u0da9\u0dd2 \u0dbb\u0dc5 \u0db4\u0dc4\u0dbb\u0da7 \u0dc4\u0dc3\u0dd4 \u0dc0\u0dd3 \u0dd0\u0dc0\u0dad \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd2\u0db8\u0da7 \u0db8 \u0ddc\u0dc4\u0dd0\u0d9a\u0dd2\u0dc0\n\n\u0db8 \u0ddc\u0db8\u0dbb\u0ddc\u0da0\u0dca\u0da0\u0db8\u0da0\u0ddd\u0db8\u0dbd \u0db6\u0dbd\u0ddc\u0d9c\u0ddc\u0dbb\u0dba\u0da7 \u0dbd\u0db8\u0dca\u0db7 \u0dc0 2KM \u0daf\u0dd4\u0dbb\u0dd2\u0db1\u0dca \u0dc0\u0dad\u0ddc \u0d87\u0dad. \u0d94\u0dc0\u0dd4\u0db1\u0dca\u0da7 \u0db8\u0d9c\u0ddc\u0da9\u0db6\u0dd2\u0db8\u0da7 \u0db4\u0dd0\u0db8\u0dd2\u0dab\u0dd3\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0ddc \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4\u0db8\u0dba\u0ddd\u0d9c\u0dba \u0dbd\u0db6\u0ddc\u0db8\u0daf \u0db8\u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d \u0db8\u0db6\u0ddd\u0da7\u0dca\u0da7\u0dd4\u0db8\u0dc0\u0dca \u0dd2\u0db8\u0dd2 \u0dbb\u0dd4 \u0d89\u0dbd\u0dca\u0dbd\u0dd3\u0db8\u0d9a\u0dca \u0dc3\u0dd2\u0daf\u0dd4 \u0dc5 \u0d85\u0dad\u0dbb \u0db4\u0dd4\u0dad\u0dca\u0dad\u0dbd\u0db8 \u0d92\u0dbb \u0dba \u0db8\u0d9c\u0db1\u0dca \u0dd3\u0dc0\u0dbb \u0d85\u0db8\u0ddc\u0dad\u0dba\u0d82\u0dc1\u0dba \u0dc4\u0ddc \u0ddc\u0dc0\u0dd2 \u0dc4\u0ddc \u0db8\u0dd6\u0dbd\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0ddc \u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dca\u0db6\u0db1\u0dca\u0dd3 \u0dbb\u0dab\u0dba \u0dc3\u0dd2\u0daf\u0dd4 \u0dbb \u0dbd\u0daf\u0dd2. \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0d9a\u0dba\n\n1. \u0db8\u0db4\u0dca\u0dbb\u0ddc\u0db8\u0daf\u0dab\u0dd2\u0dba, \u0db4\u0dd0\u0dab\u0dd2\u0db8\u0daf\u0db1\u0dd2\u0dba 53-B \u0d9c\u0db8\u0dca\u0db8\u0db4\u0ddc\u0dbd \u0db4\u0ddc\u0dbb, \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0dba \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dca\u0dc1\u0db8\u0dda \u0dc3\u0dd2\u0dc3\u0dd4\u0db1\u0dca 07 \u0db8\u0daf\u0db8 \u0d9a\u0dd4 \u0db4\u0db8\u0dab \u0db8\u0daf\u0db8\u0dc4\u0dbd\u0dca \u0db1\u0dd2\u0dc0\u0db8\u0dc3\u0dca\u0dad\u0dca\u200d\u0dd2 \u0d8b\u0da9\n\n\u0dad\u0da7\u0dca\u0da7\u0dd4\u0db8\u0dc0\u0dd2 \u0dc0\u0dd3 \u0dc3\u0dd2\u0dbb\u0dc0\u0dd2 \u0dc3\u0dd2\u0da7\u0dd2 \u0db6\u0dc0 \u0dc0\u0ddc\u0dbb\u0dca\u0dad\u0ddc \u0dc0\u0dd2\u0dba. \u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0d86\u0db4\u0daf\u0ddc \u0dc5\u0db8 \u0ddc \u0dbb\u0dab \u0d92 \u0dba \u0dc3\u0dca\u0dad\u0dca\u200d\u0db8\u0dca\u0db6\u0db1\u0dca\u0dd3 \u0dbb\u0dab\u0dba \u0dbb \u0dbd\u0daf\u0dd2. \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dd2\u0d9a\u0dca\u0d9a\u0dba\n\n1. \u0db8\u0db8\u0dca \u0dc0 \u0dc0\u0dd2\u0da7 \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0db8\u0dda \u0dc3\u0dd2\u0daf\u0dd4\u0dc0 \u0d87\u0dad\u0dd2 \u0d86\u0db4\u0daf\u0ddc\u0dc0\u0db1\u0dca\u0da7 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0dd0\u0dbd\u0dc3\u0dd2\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0db3\u0dc4\u0ddc \u0db4\u0dc4\u0dad \u0db7\u0da8 \u0dab\u0dca\u0da9\u0ddc\u0dba\u0db8\u0dca \u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dae\u0ddc \u0d9c\u0dad \u0dbb \u0d87\u0dad.\n\n\u2022 \u0d94\u0dba\u0ddc\u0dc0\u0dad\u0dca\u0dad \u0db4\u0dca\u200d\u0dbb\u0db8\u0daf\u0dca\u0dc1\u0db8\u0dda \u0db8\u0dbd\u0dc3\u0dd2\u0dbb\u0dd4\u0dbb\u0dd4 \u0db8\u0dc3\u0dca\u0dad\u0dca\u200d\u0dc0\u0dd2\u0db8\u0da7 \u0dc4\u0ddc \u0dc3\u0dca\u0dad\u0dca\u200d\u0dc4 \u0da7\u0dba\u0dd4\u0dad\u0dd4 \u0dc3\u0dca\u0dad\u0dca\u200d\u0daf\u0dc4\u0ddc 01x20 \u0db7\u0da8\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca \u2022 \u0d86\u0db4\u0daf\u0ddc\u0dc0\u0da7 \u0dbd\u0d9a\u0dca \u0da2 \u0dad\u0ddc\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0daf\u0dc4\u0ddc \u0d86\u0dc4\u0ddc\u0dbb \u0db8\u0db6\u0daf\u0ddc\u0daf\u0dd2\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0daf\u0dc4\u0ddc 01x20 \u0db7\u0da8\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca \u2022 \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd - \u0db8\u0dd2\u0dba\u0d82\u0d9c \u0dba \u0db8\u0ddc\u0dbb\u0dca\u0d9c\u0dba \u0db4\u0dd2\u0dbd\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d \u0dbb \u0d9a\u0dd2\u0dbb\u0dd2\u0db8 \u0dc3\u0dca\u0dad\u0dca\u200d\u0daf\u0dc4\u0ddc 01x30 \u0db7\u0da8\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca \u2022 \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0dc1\u0dd3\u0d9a\u0dca\u0dc2 \u0db8\u0dbb\u0ddd\u0dc4\u0dbd \u0db8\u0dc0\u0dad 01x10 \u0db7\u0da8\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca \u2022 \u0db6\u0daf\u0dd4\u0dbd\u0dca\u0dbd \u0d9c\u0dbb\u0dc3\u0dca\u0dad\u0dca\u200d\u0db7\u0ddc\u0dc0 \u0dc3\u0dca\u0dad\u0dca\u200d\u0daf\u0dc4\u0ddc 01x50 \u0db7\u0da8\u0db4\u0dd2\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0d9a\u0dca\n\n2. \u0d87\u0dbd\u0dca\u0dbd \u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dc0\u0ddc\u0dba \u0db8\u0ddc\u0dbb\u0dca\u0d9c\u0dba \u0dad\u0dc0 \u0daf\u0dd4\u0dbb\u0da7\u0dad\u0dca \u0db8\u0dc0\u0dd4\u0db1\u0dca\u0da7\u0dca \u0db8\u0dc4\u0dc0\u0db1\u0dca \u0db8\u0dc4\u0ddd\u0da7\u0dbd\u0dba \u0d85\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0dc0\u0dd2\u0dbb \u0dc0\u0dd3 \u0db4\u0dc0\u0dad\u0dd3. \u0db8\u0dd4\u0dad\u0dca \u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dc0\u0ddc\u0dba \u0dc3\u0dd2\u0da7"
