u0da7\u0dd2\u0db1\u0dd4\u0dc0\u0dbb, \u0db4\u0ddc\u0dad\u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb, \u0dad\u0dd4\u0db8\u0dca\u0db4\u0db8\u0db1\u0dca, \u0db4\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0db6\u0ddc\u0db8\u0dda\u0db8 \u0ddc\u0dbb\u0db8\u0dbd\u0dca, \u0db4\u0db1\u0dca\u0dc0\u0dd2\u0dbd, \u0dc4\u0ddc\u0dbb\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0, \u0db4\u0dd6\u0da2\u0ddc\u0dd2\u0da7\u0dd2\u0dba, \u0d9a\u0dd4\u0dab\u0dca\u0da9\u0dc3\u0dca\u0dad\u0dca\u200d\u0ddc\u0db8\u0dbd\u0dca, \u0dc4\u0dad\u0dbb\u0dbd\u0dd2\u0daf\u0dca\u0daf\n\n\u0dd1\u0d9c\u0dbd\u0dca\u0dbd\n\n\u0dbb\u0db9\u0dd4\u0d9a\u0dca , \u0d85\u0dbb\u0dab\u0ddc\u0dba , \u0db8\u0ddc\u0dc0 \u0dd0\u0dbd\u0dca\u0dbd, \u0db6\u0dd4\u0dbd\u0dad\u0dca\u0db8 \u0ddc\u0dc4\u0dd4\u0dd2\u0da7\u0dd2\u0dba, \u0dd1\u0d9c\u0dbd\u0dca\u0dbd, \u0dc0\u0dbb \u0ddc\u0db8\u0db4\u0ddc\u0dbd, \u0d9c\u0dbd\u0dd2\u0d9c\u0db8\u0dd4\u0dc0, \u0dba\u0da7\u0dd2\u0dba\u0db1\u0dca\u0db8\u0dad\u0ddc\u0da7, \u0db8\u0daf\u0dc4\u0dd2\u0d95\u0dc0\u0dd2\u0da7, \u0daf\u0dd0\u0dbb\u0db1\u0dd2\u0dba\u0d9c\u0dbd, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd\n\n\u0dbb\u0dd2\u0daf\u0dd3\u0d9c\u0db8, \u0ddc\u0dbb\u0db8\u0dca\u0db8\u0dbd, \u0d85\u0dbd\u0dc0\u0dca\u0dc0, \u0db8\u0db4\u0ddc\u0dbd\u0dca\u0d9c\u0dc4\u0db8\u0dc0\u0dbd, \u0db8\u0dbd\u0dca\u0dbd\u0dc0\u0dd2\u0da7\u0dd2\u0dba, \u0db8\u0ddc\u0dc0\u0dad\u0d9c\u0db8\n\n\u0db8\u0ddc\u0dad\u0db8\u0dbd\u0dca\n\n\u0dba\u0da7\u0dc0\u0dad\u0dca\u0dad, \u0dc0\u0dd2\u0dbd\u0dca\u0d9c\u0db8\u0dd4\u0dc0, \u0d85\u0db9\u0db1\u0dca\u0d9c\u0d9f \u0db8 \u0ddd\u0dbb\u0db8\u0dbd\u0dca, \u0d8b\u0d9a\u0dd4\u0db8\u0dc0\u0dbd, \u0dbb\u0dad\u0dca\u0db8\u0dad\u0ddc\u0da7, \u0ddc\u0d8b\u0dbd, \u0db4\u0dbd\u0dca\u0db8\u0dbd\u0db8\u0db4\u0ddc\u0dbd, \u0dbd\u0dda\u0d9c\u0dbd \u0db4\u0dbd\u0dca\u0db8\u0dbd\u0dca\u0d9c\u0db8, \u0db8\u0ddc\u0dad\u0db8\u0dbd\u0dca\n\n\u0db8\u0ddc\u0dad\u0dbb \u0d85\u0dad\u0dd4\u0dbb\u0dbd\u0dd