\u0dc5\u0db9 \u0db4\u0dc4\u0ddd\u0db8\u0dcf\u0d9c\u0db8, \u0d9a\u0dd0\u0dc3\u0dca\u0db6\u0dd1\u0dc0, \u0d9a\u0da9\u0dd4\u0db4\u0dc0\u0dbd, \u0db8\u0dc4\u0dbb\u0d9c\u0db8 \u0db4\u0dcf\u0daf\u0dd4\u0d9a\u0dca\u0d9a, \u0dc3\u0dd3\u0dad\u0dcf\u0dc0\u0d9a\n\n\u0d9c\u0dcf\u0dbd\u0dca\u0dbd \u0dad\u0dc0\u0dbd\u0db8, \u0db4\u0db1\u0dc5\u0dd4\u0dc0\n\n\u0d9c\u0db8\u0dca\u0db4\u0dc4 \u0db8\u0dd3\u0dbb\u0dd2\u0d9c\u0db8, \u0db4\u0daf\u0dcf\u0db8\u0dca\u0db4\u0dda, \u0db6\u0dd2\u0dba\u0d9c\u0db8 \u0d85\u0dad\u0dca\u0dad\u0db1\u0d9c\u0dbd\u0dca\u0dbd\n\n\u0dc4\u0db8\u0dca\u0db6\u0db1\u0dca\u0db4\u0dad\u0dcf\u0da7 \u0d95\u0db4\u0d9a\u0dca\u0db4\u0dc0\u0dbd, \u0dc0\u0dbd\u0dc3\u0dca\u0db8\u0dd4\u0dbd\u0dca\u0dbd, \u0dad\u0d82\u0d9c\u0dbd\u0dca\u0dbd, \u0db4\u0db6\u0dbd\u0dd2\u0d85\u0dad\u0dca\u0dad, \u0dc0\u0dd3\u0dbb\u0d9a\u0dd0\u0da7\u0dd2\u0dba\n\n\u0d9a\u0dc5\u0dd4\u0dad\u0dbb \u0dc0\u0dbd\u0dbd\u0dca\u0dbd\u0dcf\u0dc0\u0dd2\u0da7, \u0db8\u0dad\u0dd4\u0d9c\u0db8, \u0d85\u0d9c\u0dbd\u0dc0\u0dad\u0dca\u0dad, \u0db4\u0dcf\u0dbd\u0dd2\u0db1\u0dca\u0daf\u0db1\u0dd4\u0dc0\u0dbb \u0db4\u0dc4\u0dcf\u0dbb\u0dab, \u0db6\u0dd4\u0dbd\u0dad\u0dca\u0dc3\u0dd2\u0d82\u0dc4\u0dbd, \u0d89\u0d82\u0d9c\u0dbb\u0dd2\u0dba\n\n\u0db8\u0dc4\u0db1\u0dd4\u0dc0\u0dbb\n\n\u0d8b\u0da9\u0dd4\u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb, \u0db8\u0dd2\u0db1\u0dd2\u0db4\u0dda, \u0db4\u0daf\u0dcf\u0dc5\u0dd4\u0dc0, \u0db8\u0dd0\u0daf\u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb, \u0db4\u0dcf\u0dad\u0db4\u0dc4\u0dca\u0dc0\u0dcf\u0dc4\u0dd0\u0da7, \u0d9c\u0d9f\u0d89\u0dc4\u0dbd \u0db4\u0d9a\u0dcf\u0dbb\u0db4\u0dbd\u0dca, \u0d8b\u0da9\u0db4\u0dbd\u0dcf\u0dad, \u0db4\u0daf\u0dbd\u0dca\u0db4\u0dad\u0dcf\u0da7, \u0d9c\u0d9f\u0dc0\u0da7\u0db4\u0d9a\u0ddd\u0dbb\u0db4\u0dbd\u0dca, \u0d85\u0d9a\u0dd4\u0dbb\u0dab, \u0d8b\u0da9\u0dd4\u0db1\u0dd4\u0dc0\u0dbb, \u0dba\u0da7\u0dd2\u0db1\u0dd4\u0dc0\u0dbb, \u0db4\u0dcf\u0dad\u0daf\u0dd4\u0db8\u0dca\u0db6\u0dbb, \u0dad\u0dd4\u0db8\u0dca\u0db4\u0db4\u0db1\u0dca, \u0db4\u0dc3\u0dca\u0db6\u0dcf\u0db4\u0dda\u0db4\u0d9a\u0dcf\u0dbb\u0db4\u0dbd\u0dca, \u0db4\u0db1\u0dca\u0dc0\u0dd2\u0dbd, \u0dc4\u0dcf\u0dbb\u0dd2\u0dc3\u0dca\u0db4\u0dad\u0dca\u0dad\u0dd4\u0dc0, \u0db4\u0dd6\u0da2\u0dcf\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0d9a\u0dd4\u0dab\u0dca\u0da9\u0da9\u0dc3\u0dcf\u0db4\u0dbd\u0dca, \u0dc4\u0dad\u0dbb\u0dbd\u0dd2\u0daf\u0dca\u0daf\n\n\u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbd\n\n\u0dbb\u0db9\u0dd4\u0d9a\u0dca\u0d9a\u0db1, \u0d85\u0dbb\u0dab\u0dcf\u0dba\u0d9a, \u0db8\u0dcf\u0dc0\u0db1\u0dd0\u0dbd\u0dca\u0dbd, \u0db6\u0dd4\u0dbd\u0dad\u0dca\u0db4\u0d9a\u0dcf\u0dc4\u0dd4\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0d9a\u0dd1\u0d9c\u0dbd\u0dca\u0dbd, \u0dc0\u0dbb\u0d9a\u0dcf\u0db4\u0db4\u0dcf\u0dbd, \u0d9c\u0dbd\u0dd2\u0d9c\u0db8\u0dd4\u0dc0, \u0dbb\u0dd4\u0dc0\u0db1\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0dba\u0da7\u0dd2\u0dba\u0db1\u0dca\u0db4\u0dad\u0dcf\u0da7, \u0daf\u0dd0\u0dbb\u0db1\u0dd2\u0dba\u0d9c\u0dbd, \u0db4\u0daf\u0dd2\u0d95\u0dc0\u0dd2\u0da7\n\n\u0d9a\u0dd4\u0dbb\u0dd4\u0dab\u0dd1\u0d9c\u0dbd \u0db4\u0db4\u0dcf\u0dbd\u0dca\u0d9c\u0dc4\u0db4\u0dc0\u0dbd \u0db8\u0dbd\u0dca\u0dbd\u0dc0\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0db8\u0dcf\u0dc0\u0dad\u0d9c\u0db8, \u0dbb\u0dd2\u0daf\u0dd3\u0d9c\u0db8, \u0db1\u0dcf\u0dbb\u0db8\u0dca\u0db8\u0dbd, \u0d85\u0dbd\u0dc0\u0dca\u0dc0\n\n\u0db4\u0db8\u0dcf\u0dab\u0dbb\u0dcf\u0d9c\u0dbd \u0db6\u0da9\u0dbd\u0dca\u0d9a\u0dd4\u0db9\u0dd4\u0dbb, \u0dc0\u0dd0\u0dbd\u0dca\u0dbd\u0dc0\u0dcf\u0dba \u0db6\u0dd2\u0db6\u0dd2\u0dbd, \u0db8\u0dd0\u0daf\u0d9c\u0db8\n\n\u0db8\u0dcf\u0dad\u0db4\u0dbd\u0dca\n\n\u0dba\u0da7\u0dc0\u0dad\u0dca\u0dad, \u0dc0\u0dd2\u0dbd\u0dca\u0d9c\u0db8\u0dd4\u0dc0, \u0d85\u0db9\u0db1\u0dca\u0d9c\u0d9f \u0db4\u0d9a\u0ddd\u0dbb\u0db4\u0dbd\u0dca, \u0d8b\u0d9a\u0dd4\u0db4\u0dc0\u0dbd, \u0dbb\u0dad\u0dca\u0db4\u0dad\u0dcf\u0da7,\n\n\u0db1\u0dcf\u0d8b\u0dbd, \u0db4\u0dbd\u0dca\u0db4\u0dbd\u0db4\u0db4\u0dcf\u0dbd, \u0dbd\u0dda\u0d9c\u0dbd \u0db4\u0dbd\u0dca\u0db4\u0dbd\u0dca\u0d9c\u0db8, \u0db8\u0dcf\u0dad\u0db4\u0dbd\u0dca, \u0d8b\u0d9a\u0dd4\u0db4\u0dc0\u0dbd\n\n\u0db8\u0dcf\u0dad\u0dbb\n\n\u0db4\u0dc3\u0dca\u0db4\u0d9c\u0dcf\u0da9, \u0dc4\u0d9a\u0dca\u0db8\u0db1, \u0db8\u0dd4\u0dbd\u0da7\u0dd2\u0dba\u0db1, \u0d9a\u0da9\u0dc0\u0dad\u0dca \u0dc3\u0dad\u0dbb, \u0db4\u0dd2\u0da7\u0db6\u0dd0\u0daf\u0dca\u0daf\u0dbb, \u0db4\u0d9a\u0dcf\u0da7\u0db4\u0db4\u0dcf\u0dbd, \u0d9a\u0dd2\u0dbb\u0dd2\u0db1\u0dca\u0daf \u0db4\u0dd4\u0dc4\u0dd4\u0dbd\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0daf\u0dd2\u0d9a\u0dca\u0dc0\u0dd0\u0dbd\u0dca\u0dbd, \u0db4\u0daf\u0dc0\u0dd2\u0db1\u0dd4\u0dc0\u0dbb, \u0dad\u0dd2\u0dc4\u0db4\u0d9c\u0dcf\u0da9, \u0dc0\u0dd0\u0dbd\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba, \u0d85\u0dad\u0dd4\u0dbb\u0dbd\u0dd2\u0dba, \u0d85\u0d9a\u0dd4\u0dbb\u0dd0\u0d9a\u0dca\u0d9a, \u0dc0\u0dd0\u0dbd\u0dd2\u0d9c\u0db8, \u0db8\u0dcf\u0dbd\u0dd2\u0db8\u0dca\u0db6\u0da9\n\n\u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba\n\n\u0dc0\u0dbd\u0db4\u0db4\u0db1\u0dca, \u0dc4\u0d9f\u0dd4\u0dbb\u0db1\u0dca\u0db4\u0d9a\u0dad, \u0db1\u0dd2\u0dbd\u0dca\u0daf\u0dab\u0dca\u0da9\u0da9\u0dcf\u0dd2\u0db1\u0dca\u0db1, \u0db8\u0dad\u0dd4\u0dbb\u0da7 \u0db1\u0dd4\u0dc0\u0dbb\u0d91\u0dc5\u0dd2\u0dba, \u0db4\u0d9a\u0dcf\u0dad\u0dca\u0db8\u0db4\u0dbd\u0dca \u0db1\u0dd0\u0db4\u0d9c\u0db1\u0dd2\u0dbb, \u0db4\u0d9a\u0dcf\u0dad\u0dca\u0db8\u0db4\u0dbd\u0dca \u0db6\u0da7\u0dd2\u0dbb, \u0dad\u0dbd\u0dc0\u0d9a\u0dd0\u0db4\u0dbd\u0dca, \u0d85\u0db9\u0d9c\u0db8\u0dd4\u0dc0, \u0db4\u0db1\u0ddd\u0dbb\u0dca\u0dc0\u0dd4\u0da9\u0dca\n\n\u0dbb\u0dad\u0dca\u0db1\u0db4\u0dd4\u0dbb\n\n\u0dc0\u0dd0\u0dbd\u0dd2\u0db4\u0d9c\u0db4\u0db4\u0dcf\u0dbd, \u0db4\u0d9a\u0dcf\u0da7\u0db4\u0db4\u0dcf\u0dbd, \u0d87\u0db9\u0dd2\u0dbd\u0dd2\u0db4\u0dd2\u0da7\u0dd2\u0dba\n\n\u0d9a\u0dd2\u0dbb\u0dd2\u0d87\u0dda\u0dbd, \u0d87\u0dc4\u0dd0\u0dbd\u0dd2\u0dba\u0dc0\u0d9c\u0dcf\u0da9, \u0d9a\u0dd4\u0dbb\u0dd4\u0dc0\u0dd2\u0da7, \u0dbb\u0dad\u0dca\u0dad\u0db1\u0db4\u0dd4\u0dbb, \u0db4\u0dd0\u0dda\u0db8\u0da9\u0dd4\u0dda\u0dbd, \u0dc0\u0d9c\u0dcf\u0da9\u0d9a\u0dc0\u0dc0\u0dbd, \u0