0d\u0dbb\u0db0\u0dca\u200d\u0dcf\u0db1 \u0da2\u0dbd\u0dcf \u0d86\u0dc1\u0dca\u200d\u0dbb\u0dd2\u0dad \u0dc0\u0dcf\u0db1\u0dca \u0dc0\u0daf\u0dcf\u0dbb\u0da7\u0dd4 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dd2\u0dbb\u0dd3\u0db8\u0dca ( 2025.12.06 \u0daf\u0dd2\u0db1 1200 \u0db4\u0dd0\u0dba\u0da7 )\n\n(\u0db8\u0dd6\u0dbd\u0ddc\u0dc1\u0dca\u200d\u0dbb - \u0d85\u0daf\u0ddc\u0dc5 \u0dc0\u0ddc\u0dbb\u0dd2 \u0d89\u0d82\u0da2\u0dd2\u0db8\u0db1\u0dca\u0dbb\u0dd4 \u0ddc\u0dbb\u0dca\u0dba\u0ddc\u0dbd) \u2022 \u0dc0\u0dd0\u0daf\u0d9c\u0dad\u0dca\u0dad - \u0d89\u0dc4\u0dad \u0dc3\u0db3\u0dc4\u0db1\u0dca \u0da2\u0dbd\u0dcf \u0dc4\u0dcf \u0dc0\u0dd0\u0dda \u0dc0\u0dbd\u0da7 \u0d85\u0db8\u0dad\u0dbb\u0dc0 \u0daf\u0dd2\u0dc0\u0dba\u0dd2\u0dc0\u0db1\u0dca \u0d85\u0dc0\u0db1\u0d9a\u0dd4\u0dad\u0dca\u0dad \u0da2\u0dbd\u0dcf \u0dc4\u0dcf \u0dc0\u0dd0\u0dda \u0dbb\u0dd0\u0dc3\u0d9a \u0dc0\u0dcf\u0db1\u0dca \u0dc0\u0daf\u0dcf\u0dbb\u0da7\u0dd4 \u0dc0\u0dd2\u0dc0\u0dd8\u0dad \u0d9a\u0dbb \u0dad\u0dd2\u0dc0\u0dda. 2025.12.06 \u0daf\u0dd2\u0db1 1200 \u0db4\u0dd0\u0dba\u0da7 \u0db8\u0dcf\u0dbb\u0dca\u0d9c \u0da2\u0dbd\u0dc0\u0dba\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd3 \u0d87\u0dad\u0dd2 \u0dc3\u0dca\u0dae\u0dcf\u0db1\n\n\u2756 \u0d85\u0db8\u0dca\u0db4\u0ddc\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u0dca\u200d\u0dbb\u0dd2\u0d9a\u0dca \u0dba\n\n\u27a2 \u0dc0\u0dd2\u0dad\u0db1\u0dca\u0db8\u0dc0\u0dca\u0dbd\u0dd2 \u0db4\u0dca\u200d\u0dbb\u0ddc.\u0db8\u0dbd\u0dca. \u0db8 \u0ddc\u0da7\u0dca\u0da8\u0ddc \u0db8\u0dda \u0d9a\u0dd2\u0da9\u0db1\u0dca\u0d9c\u0dd2 \u0db4\u0ddc\u0dbd\u0db8 \u0d85\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbd\u0dd2\u0db1\u0dca \u0d85\u0da9\u0dd2 03 \u0d9a\u0dca \u0db4\u0db8\u0dab \u0da2\u0dbd\u0db8\u0dba\u0db1\u0dca \u0dba\u0da7\u0dc0\u0dd3 \u0d87\u0dad. \u0db8\u0ddc\u0dbb\u0dca\u0d9c\u0dba\n\n\u0dc0\u0dc3\u0dca\u0dad\u0dca\u200d\u0ddc \u0d87\u0dad.\n\n\u2756 \u0d85\u0db1\u0dd4\u0dbb\u0ddc\u0db0\u0db4\u0dd4\u0dbb \u0daf\u0dd2\u0dc3\u0dca\u0dad\u0dca\u200d\u0dbb\u0dad\u